<script>
  (function () {
    var footer = document.querySelector('.site-footer-wrapper[data-section-id="footer"]');
    if (!footer) return;
    footer.querySelectorAll('.footer-quicklinks__toggle').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var parent = btn.closest('.footer-quicklinks__parent');
        if (!parent) return;
        var submenu = parent.querySelector('.footer-quicklinks__submenu');
        if (!submenu) return;
        var isOpen = !submenu.hasAttribute('hidden');
        if (isOpen) {
          submenu.setAttribute('hidden', '');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          submenu.removeAttribute('hidden');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // ===== Mobile-only reorder: move tagline/contact/app-download to sit
    // after the accordion link columns. On desktop it stays inside
    // .footer-brand, under the logo. Reparenting via JS instead of CSS
    // order/grid-area avoids recreating the multi-row grid-spanning bug
    // (uneven row heights) that affected this section previously.
    var infoBlock = footer.querySelector('#FooterBrandInfo');
    var brandWrap = footer.querySelector('.footer-brand');
    var navGrid = footer.querySelector('#FooterNavGrid');
    if (infoBlock && brandWrap && navGrid) {
      var mq = window.matchMedia('(max-width: 749px)');
      var placeInfoBlock = function () {
        if (mq.matches) {
          if (infoBlock.previousElementSibling !== navGrid) {
            navGrid.insertAdjacentElement('afterend', infoBlock);
          }
        } else {
          if (infoBlock.parentElement !== brandWrap) {
            brandWrap.appendChild(infoBlock);
          }
        }
      };
      placeInfoBlock();
      if (mq.addEventListener) {
        mq.addEventListener('change', placeInfoBlock);
      } else if (mq.addListener) {
        mq.addListener(placeInfoBlock);
      }
    }
  })();
</script>
