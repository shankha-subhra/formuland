<div class="formuland-footer-wrapper">
<div class="shopify-section" id="shopify-section-footer"><footer class="site-footer-wrapper" data-section-id="footer" data-section-type="footer" role="contentinfo">
<style>
    /* ===== Brand sidebar (logo / tagline / contact) — matches Figma left column ===== */
    .footer-brand {
      grid-area: brand;
    }
    .footer-brand__logo-link {
      display: inline-block;
      margin-bottom: 14px;
    }
    .footer-brand__logo-link img {
      display: block;
      width: 197px;
      height: auto;
    }
    .footer-brand__logo-link--text {
      font-family: 'Libre Baskerville', serif;
      font-style: italic;
      font-weight: 500;
      font-size: 28px;
      color: #FBFBF8;
      text-decoration: none;
    }
    .footer-brand__tagline {
      font-family: 'Libre Franklin', sans-serif;
      font-size: 12px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: rgba(251, 251, 248, 0.6);
      margin: 0 0 22px;
    }
    .footer-brand__contact-text {
      font-family: 'Libre Franklin', sans-serif;
      font-size: 15px;
      line-height: 1.5;
      color: rgba(251, 251, 248, 0.85);
      margin: 0 0 6px;
    }
    .footer-brand__email {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Libre Franklin', sans-serif;
      font-size: 15px;
      font-weight: 600;
      color: var(--footer-accent, #C9A667);
      text-decoration: underline;
      margin-bottom: 0;
    }
    .footer-brand__email-icon {
      flex-shrink: 0;
      color: var(--footer-accent, #C9A667);
    }

    /* Original theme markup for this block has no flex styling of its own —
       force the tight vertical rhythm and side-by-side badges seen in Figma */
    .footer-app-badges {
      margin-top: 28px !important;
      padding: 0 !important;
    }
    .footer-app-heading {
      margin: 0 0 14px !important;
    }
    .footer-badge-wrapper {
      display: flex !important;
      flex-direction: row !important;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .footer-badge-wrapper a {
      display: block;
      line-height: 0;
    }
    .footer-badge {
      height: 40px;
      width: auto;
      display: block;
    }

    /* ===== Figma color / type pass on the existing block system ===== */
    .site-footer-wrapper {
      background: #13322B;
      color: #FBFBF8;
      padding-top: 60px;
    }
    .footer__title {
      font-family: 'Libre Franklin', sans-serif;
      font-size: 16px;
      font-weight: 500;
      letter-spacing: 0;
      line-height: 24px;
      color: var(--footer-accent, #E6F28C);
      border-bottom: none !important;
      text-decoration: none !important;
      padding-bottom: 0 !important;
      box-shadow: none !important;
    }
    .footer__title::after,
    .footer__title::before {
      display: none !important;
      content: none !important;
    }
    .footer-app-heading {
      font-family: 'Libre Franklin', sans-serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #FBFBF8;
      margin: 0 0 12px;
    }
    .footer-quicklinks a,
    .footer-quicklinks__submenu a {
      font-family: 'Libre Franklin', sans-serif;
      font-weight: 400;
      font-size: 16px;
      line-height: 24px;
      color: rgba(251, 251, 248, 0.85);
    }
    .footer-quicklinks a:hover,
    .footer-quicklinks__submenu a:hover {
      color: #FBFBF8;
    }

    /* Chevron on the top-level accordion trigger only rotates/shows on mobile —
       desktop stays static and open, matching Figma (no arrows shown there) */
    @media (min-width: 750px) {
      .footer__title svg { display: none; }
      /* The "Mobile accordion" block setting should only affect mobile —
         force the link list / rte body to always render at desktop
         regardless of the open/closed-by-default class added there. */
      [data-accordion-body-mobile] {
        display: block !important;
        height: auto !important;
        max-height: none !important;
        visibility: visible !important;
        opacity: 1 !important;
      }
    }
    @media (max-width: 749px) {
      .footer__title[aria-expanded="true"] svg { transform: rotate(90deg); }
      .footer__title svg { transition: transform .2s ease; }
    }

    /* ===== Desktop layout: brand sidebar beside the 4 link columns ===== */
    @media (min-width: 750px) {
      .wrapper.site-footer {
        display: grid;
        grid-template-columns: 280px 1fr;
        grid-template-areas:
          "brand columns"
          "extras extras"
          "legal legal";
        column-gap: 64px;
        row-gap: 32px;
        align-items: start;
      }
      .grid.grid--uniform { grid-area: columns; margin: 0; }
      .grid.footer-secondary-wrapper { grid-area: extras; }
    }

    /* Mobile: logo stays at top of .footer-brand; tagline/contact/app
       download is moved (via JS) to sit after the accordion columns —
       styled here as its own centered block in that new position. */
    @media (max-width: 749px) {
      .footer-brand { text-align: center; margin-bottom: 8px; }
      .footer-brand__logo-link img { margin: 0 auto; }

      .footer-brand__info {
        text-align: center;
        margin-top: 32px;
        padding-top: 28px;
      }
      .footer-brand__info .footer-badge-wrapper {
        justify-content: center;
      }

      .footer__title {
        margin: 0;
        padding: 22px 0;
        min-height: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        line-height: 24px;
      }
      .footer-quicklinks {
        padding-bottom: 22px;
      }
      .footer-quicklinks__submenu {
        padding-bottom: 4px;
      }
    }

    /* ===== Bottom legal / copyright bar ===== */
    .footer-bottom-bar {
      grid-area: legal;
      border-top: 1px solid rgba(251, 251, 248, 0.12);
      margin-top: 40px;
      padding: 24px 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      font-family: 'Libre Franklin', sans-serif;
      font-size: 13px;
    }
    .footer-bottom-bar__copyright {
      color: rgba(251, 251, 248, 0.7);
      margin: 0;
    }
    .footer-bottom-bar__legal {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .footer-bottom-bar__legal a {
      color: rgba(251, 251, 248, 0.7);
      text-decoration: none;
    }
    .footer-bottom-bar__legal a:hover {
      color: #FBFBF8;
      text-decoration: underline;
    }
    .footer-bottom-bar__divider {
      color: rgba(251, 251, 248, 0.4);
    }
    @media (max-width: 749px) {
      .footer-bottom-bar {
        flex-direction: column;
        text-align: center;
      }
    }

    /* ===== Existing nested-submenu styles (unchanged) ===== */
    .footer-quicklinks__parent { list-style: none; }
    .footer-quicklinks__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .footer-quicklinks__head > a { flex: 1 1 auto; }
    .footer-quicklinks__toggle {
      background: none;
      border: 0;
      padding: 4px;
      margin: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      color: inherit;
      line-height: 0;
      flex: 0 0 auto;
    }
    .footer-quicklinks__toggle svg {
      width: 12px;
      height: 12px;
      transition: transform .2s ease;
    }
    .footer-quicklinks__toggle[aria-expanded="true"] svg { transform: rotate(90deg); }
    .footer-quicklinks__submenu {
      list-style: none;
      margin: 6px 0 10px;
      padding-left: 14px;
    }
    .footer-quicklinks__submenu[hidden] { display: none; }
    .footer-quicklinks__submenu li { margin-top: 4px; }
  </style>
