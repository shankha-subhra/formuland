</section>
<script>
  (function () {
    var root = document.getElementById('ffq-template--22898945491163__faq_home_9gXthq');
    if (!root) return;

    var questions = Array.prototype.slice.call(root.querySelectorAll('[data-ffq-question]'));

    function setOpen(btn, open) {
      var answer = document.getElementById(btn.getAttribute('aria-controls'));
      if (!answer) return;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      answer.style.maxHeight = open ? answer.scrollHeight + 'px' : '0px';
    }

    questions.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var isOpen = btn.getAttribute('aria-expanded') === 'true';
        questions.forEach(function (other) {
          if (other !== btn) setOpen(other, false);
        });
        setOpen(btn, !isOpen);
      });
    });

    // Open the first item on load if configured
    var initiallyOpen = root.querySelector('[data-ffq-question][aria-expanded="true"]');
    if (initiallyOpen) setOpen(initiallyOpen, true);

    // Keep open panel height correct on resize
    window.addEventListener('resize', function () {
      questions.forEach(function (btn) {
        if (btn.getAttribute('aria-expanded') === 'true') setOpen(btn, true);
      });
    }, { passive: true });
  })();
</script>
</section>
