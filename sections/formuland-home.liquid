<script>
  (function () {
    var root = document.getElementById('fct-template--22898945491163__collection_tabs_home_YCgw3G');
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-fct-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-fct-panel]'));
    var prevBtn = root.querySelector('[data-fct-prev]');
    var nextBtn = root.querySelector('[data-fct-next]');
    var GAP = 24;

    function activePanel() {
      for (var i = 0; i < panels.length; i++) {
        if (!panels[i].hidden) return panels[i];
      }
      return panels[0] || null;
    }

    function activeSlider() {
      var p = activePanel();
      return p ? p.querySelector('[data-fct-slider]') : null;
    }

    function cardStep(slider) {
      var card = slider.querySelector('.fct__card');
      return card ? card.getBoundingClientRect().width + GAP : slider.clientWidth;
    }

    function updateUI() {
      var slider = activeSlider();
      if (!slider) return;
      var maxScroll = slider.scrollWidth - slider.clientWidth;
      if (prevBtn) prevBtn.disabled = slider.scrollLeft <= 0;
      if (nextBtn) nextBtn.disabled = slider.scrollLeft >= maxScroll - 1;

      var panel = activePanel();
      var thumb = panel ? panel.querySelector('[data-fct-progress]') : null;
      if (!thumb) return;
      if (maxScroll <= 0) {
        thumb.style.transform = 'translateX(0) scaleX(1)';
        return;
      }
      var visibleFrac = slider.clientWidth / slider.scrollWidth;
      var scrollFrac = slider.scrollLeft / maxScroll;
      var travel = (1 - visibleFrac) * scrollFrac * 100;
      thumb.style.transform = 'translateX(' + travel + '%) scaleX(' + visibleFrac + ')';
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var idx = tab.getAttribute('data-fct-tab');
        tabs.forEach(function (t) {
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        panels.forEach(function (p) {
          p.hidden = p.getAttribute('data-fct-panel') !== idx;
        });
        var slider = activeSlider();
        if (slider) slider.scrollLeft = 0;
        updateUI();
      });
    });

    if (prevBtn) prevBtn.addEventListener('click', function () {
      var slider = activeSlider();
      if (slider) slider.scrollBy({ left: -cardStep(slider), behavior: 'smooth' });
    });
    if (nextBtn) nextBtn.addEventListener('click', function () {
      var slider = activeSlider();
      if (slider) slider.scrollBy({ left: cardStep(slider), behavior: 'smooth' });
    });

    var ticking = false;
    root.addEventListener('scroll', function (e) {
      if (!e.target || !e.target.hasAttribute || !e.target.hasAttribute('data-fct-slider')) return;
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        updateUI();
        ticking = false;
      });
    }, true);

    window.addEventListener('resize', updateUI, { passive: true });
    updateUI();
  })();
</script>
