{% assign features = collection.metafields.custom.why_buy.value %}
{% if features != blank %}
<section class="shopify-section fcc-owb-section" id="shopify-section-{{ section.id }}">
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&amp;family=Libre+Franklin:wght@400;500;600&amp;family=Tenor+Sans&amp;display=swap" rel="stylesheet"/>
<style data-shopify="">
  #fcc-owb-{{ section.id }} {
    position: relative;
    background-color: #13322b;
    overflow: hidden;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #0b211c 0%,
      rgba(11, 33, 28, 0.55) 45%,
      rgba(0, 0, 0, 0) 100%
    );
    opacity: 0.0;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__wrap {
    position: relative;
    z-index: 1;
    max-width: 1360px;
    margin: 0 auto;
    padding: 100px 24px 100px;
    min-height: 900px;
    display: flex;
    align-items: center;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__content {
    max-width: 600px;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__eyebrow {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 15px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #efefe3;
    margin: 0 0 16px;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__heading {
    font-family: 'Libre Baskerville', serif !important;
    font-weight: 400 !important;
    font-size: 48px !important;
    line-height: 1.3 !important;
    color: #efefe3;
    margin: 0 0 24px;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__heading p {
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    font-weight: inherit;
    color: inherit;
    letter-spacing: inherit;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__heading em {
    font-style: italic;
    color: #e6f28c;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__desc {
    font-family: 'Libre Franklin', sans-serif;
    font-size: 16px;
    line-height: 1.65;
    color: #efefe3;
    margin: 0 0 32px;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__desc p {
    margin: 0 0 12px;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__desc p:last-child { margin-bottom: 0; }
  #fcc-owb-{{ section.id }} .fcc-owb__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__item {
    position: relative;
    padding-left: 28px;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__item::before {
    content: "\2726";
    position: absolute;
    left: 0;
    top: 0.15em;
    font-size: 13px;
    color: #e6f28c;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__item-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 22px;
    line-height: 1.4;
    color: #efefe3;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__details summary {
    list-style: none;
    cursor: pointer;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__details summary::-webkit-details-marker { display: none; }
  #fcc-owb-{{ section.id }} .fcc-owb__details summary::after {
    content: "+";
    display: inline-block;
    margin-left: 10px;
    font-family: 'Libre Franklin', sans-serif;
    font-weight: 300;
    font-size: 20px;
    line-height: 1;
    vertical-align: baseline;
    color: #e6f28c;
    opacity: 0.85;
    transition: transform 0.25s ease;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__details[open] summary::after { transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) {
    #fcc-owb-{{ section.id }} .fcc-owb__details summary::after { transition: none; }
  }
  #fcc-owb-{{ section.id }} .fcc-owb__item-body {
    font-family: 'Libre Franklin', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #efefe3;
    opacity: 0.9;
    margin-top: 6px;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__item-body p {
    margin: 0 0 8px;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }
  #fcc-owb-{{ section.id }} .fcc-owb__item-body p:last-child { margin-bottom: 0; }
  #fcc-owb-{{ section.id }} .fcc-owb__bg--mobile { display: none; }

  @media (max-width: 1024px) {
    #fcc-owb-{{ section.id }} .fcc-owb__wrap {
      padding: 64px 20px calc(64px + 360px);
      min-height: 0;
      align-items: flex-start;
    }
    #fcc-owb-{{ section.id }} .fcc-owb__bg img { object-position: center bottom; }
    #fcc-owb-{{ section.id }} .fcc-owb__content { max-width: 100%; }
    #fcc-owb-{{ section.id }} .fcc-owb__heading { font-size: 34px !important; }
    #fcc-owb-{{ section.id }} .fcc-owb__item-title { font-size: 19px; }
    
      #fcc-owb-{{ section.id }} .fcc-owb__bg--desktop { display: none; }
      #fcc-owb-{{ section.id }} .fcc-owb__bg--mobile { display: block; }
    
    #fcc-owb-{{ section.id }} .fcc-owb__bg::after {
      background: linear-gradient(
        180deg,
        #0b211c 0%,
        rgba(11, 33, 28, 0.55) 70%,
        rgba(0, 0, 0, 0) 100%
      );
    }
  }
</style>
<section aria-labelledby="fcc-owb-heading-{{ section.id }}" class="fcc-owb" id="fcc-owb-{{ section.id }}"><div aria-hidden="true" class="fcc-owb__bg fcc-owb__bg--desktop">
{%- if section.settings.bg_image_desktop != blank -%}
  {{ section.settings.bg_image_desktop | image_url: width: 2400 | image_tag: 
     loading: 'lazy',
     sizes: '100vw',
     widths: '900, 1400, 1920, 2400',
     style: 'object-position:50.0% 49.414%; width: 100%; height: 100%; object-fit: cover;'
  }}
{%- else -%}
  <img alt="" height="1250" loading="lazy" src="//formuland.com/cdn/shop/files/section_20.png?v=1787239840&amp;width=2400" srcset="//formuland.com/cdn/shop/files/section_20.png?v=1787239840&amp;width=900 900w, //formuland.com/cdn/shop/files/section_20.png?v=1787239840&amp;width=1400 1400w, //formuland.com/cdn/shop/files/section_20.png?v=1787239840&amp;width=1920 1920w, //formuland.com/cdn/shop/files/section_20.png?v=1787239840&amp;width=2400 2400w" style="object-position:50.0% 49.414%;" width="2400"/>
{%- endif -%}
</div><div aria-hidden="true" class="fcc-owb__bg fcc-owb__bg--mobile">
{%- if section.settings.bg_image_mobile != blank -%}
  {{ section.settings.bg_image_mobile | image_url: width: 1200 | image_tag: 
     loading: 'lazy',
     sizes: '100vw',
     widths: '600, 900, 1200',
     style: 'object-position:50.0% 94.824%; width: 100%; height: 100%; object-fit: cover;'
  }}
{%- else -%}
  <img alt="" height="2966" loading="lazy" src="//formuland.com/cdn/shop/files/section_21.png?v=1787239909&amp;width=1200" srcset="//formuland.com/cdn/shop/files/section_21.png?v=1787239909&amp;width=600 600w, //formuland.com/cdn/shop/files/section_21.png?v=1787239909&amp;width=900 900w, //formuland.com/cdn/shop/files/section_21.png?v=1787239909&amp;width=1200 1200w" style="object-position:50.0% 94.824%;" width="1200"/>
{%- endif -%}
</div><div class="fcc-owb__wrap">
<div class="fcc-owb__content"><h2 class="fcc-owb__heading" id="fcc-owb-heading-{{ section.id }}">{{ section.settings.heading }}</h2><div class="fcc-owb__desc">{{ section.settings.description }}</div><ul class="fcc-owb__list">
{%- for item in features -%}
  <li class="fcc-owb__item"><details class="fcc-owb__details">
  <summary class="fcc-owb__item-title">{{ item.title.value }}</summary>
  <div class="fcc-owb__item-body">{{ item.content | metafield_tag }}</div>
  </details></li>
{%- endfor -%}
</ul></div>
</div>
</section>
</section>
{% endif %}
{% schema %}
{
  "name": "Collection Why Buy",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image_desktop",
      "label": "Background Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image Mobile"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<em>HiPP Organic Baby Formula</em> at Formuland"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Formuland has served U.S. families with European baby formula since 2014. Over that time, we have built direct relationships with our European supplier partners and developed the logistics infrastructure to store, handle, and ship formulas properly, from the manufacturer's facility to your front door.</p>"
    }
  ],
  "presets": [
    {
      "name": "Formula Collection Why Buy"
    }
  ]
}
{% endschema %}
