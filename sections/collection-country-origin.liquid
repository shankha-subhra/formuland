<script>
  (function() {
    var slider = document.getElementById('fcc-co-slider-template--22974334501083__fcc_country_origin_DVBpCP');
    var btnPrev = document.getElementById('fcc-co-prev-template--22974334501083__fcc_country_origin_DVBpCP');
    var btnNext = document.getElementById('fcc-co-next-template--22974334501083__fcc_country_origin_DVBpCP');

    if (!slider || !btnPrev || !btnNext) return;

    var scrollAmount = function() {
      var card = slider.querySelector('.fcc-co__card');
      if(card) {
        return card.offsetWidth + 16;
      }
      return 300;
    };

    btnPrev.addEventListener('click', function() {
      slider.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
    });

    btnNext.addEventListener('click', function() {
      slider.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
    });
  })();
</script>
