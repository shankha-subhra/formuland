<script>
  (function () {
    var root = document.querySelector('[data-section-id="template--22974334501083__collection_custom_2_AGXiPQ"]');
    if (!root) return;

    var collectionUrl = root.getAttribute('data-fcc2-collection-url') || window.location.pathname;

    var dropdowns = root.querySelectorAll('[data-fcc2-dropdown]');
    dropdowns.forEach(function (dd) {
      var toggle = dd.querySelector('[data-fcc2-dropdown-toggle]');
      if (!toggle) return;
      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = dd.getAttribute('data-fcc2-open') === 'true';
        dropdowns.forEach(function (other) {
          if (other !== dd) {
            other.removeAttribute('data-fcc2-open');
            var t = other.querySelector('[data-fcc2-dropdown-toggle]');
            if (t) t.setAttribute('aria-expanded', 'false');
          }
        });
        if (isOpen) {
          dd.removeAttribute('data-fcc2-open');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          dd.setAttribute('data-fcc2-open', 'true');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) {
        dropdowns.forEach(function (dd) {
          dd.removeAttribute('data-fcc2-open');
          var t = dd.querySelector('[data-fcc2-dropdown-toggle]');
          if (t) t.setAttribute('aria-expanded', 'false');
        });
      }
    });

    var form = root.querySelector('form[id^="fcc2-filter-form"]');
    if (form) {
      form.addEventListener('change', function (e) {
        if (!e.target.matches('[data-fcc2-filter-input]')) return;
        var formData = new FormData(form);
        var params = new URLSearchParams();
        formData.forEach(function (val, key) {
          if (val) params.append(key, val);
        });
        window.location.href = collectionUrl + (params.toString() ? '?' + params.toString() : '');
      });
    }
  })();
</script>
