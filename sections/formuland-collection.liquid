<!-- Copied from https://formuland.com/collections/hipp-formula -->
<div class="formuland-custom-wrapper">
<main class="main-content" id="MainContent">
<div class="shopify-section" id="shopify-section-template--22974334501083__collection_custom_2_AGXiPQ">
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&amp;family=Libre+Franklin:wght@400;500;600&amp;family=Tenor+Sans&amp;display=swap" rel="stylesheet"/>
<div data-fcc2-collection-url="{{ collection.url }}" data-section-id="{{ section.id }}" data-section-type="collection-custom-2">
<div class="fcc2">
<div class="wrapper"><header class="fcc2__hero"><p class="fcc2__hero__eyebrow">{{ section.settings.eyebrow_text }}</p><h1 class="fcc2__hero__title">{{ collection.title }}</h1><div class="fcc2__hero__description rte">
{{ collection.description }}
</div><div class="fcc2__hero__trustpilot-live">
<div class="trustpilot-widget" data-businessunit-id="5ccc1a9751b9830001f2b7ef" data-locale="en-US" data-review-languages="en" data-stars="4,5" data-style-height="150px" data-style-width="100%" data-template-id="53aa8912dec7e10d38f59f36">
<a href="https://www.trustpilot.com/review/formuland.com" rel="noopener" target="_blank">Trustpilot</a>
</div>
</div>
<script async="" src="https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js"></script></header><div class="fcc2__filterbar" data-fcc2-filterbar="">

<form
  id="fcc2-filter-form-{{ section.id }}"
  class="fcc2__filterbar__form"
  action="{{ collection.url }}"
  method="get"
  data-fcc2-filter-form
>
  {%- assign age_filter_found = false -%}
  {%- assign formula_filter_found = false -%}

  {%- for filter in collection.filters -%}

    {%- if filter.param_name == 'filter.p.m.custom.baby_age' -%}
      {%- assign age_filter_found = true -%}

      <div class="fcc2__dropdown" data-fcc2-dropdown>
        <button
          type="button"
          class="fcc2__dropdown__toggle"
          data-fcc2-dropdown-toggle
          aria-expanded="false"
          aria-haspopup="listbox"
        >
          <span class="fcc2__dropdown__label">
            {{ section.settings.age_filter_label | default: 'Age' }}
          </span>

          <svg
            class="fcc2__dropdown__caret"
            viewBox="0 0 12 8"
            width="12"
            height="8"
            aria-hidden="true"
          >
            <path
              d="M1 1l5 5 5-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          class="fcc2__dropdown__panel"
          data-fcc2-dropdown-panel
          role="listbox"
        >
          <ul class="fcc2__dropdown__list">
            {%- for value in filter.values -%}
              <li class="fcc2__dropdown__item">
                <label class="fcc2__dropdown__option{% if value.count == 0 and value.active == false %} fcc2__dropdown__option--disabled{% endif %}">
                  <span class="fcc2__dropdown__option__text">
                    {{ value.label | upcase }}
                  </span>

                  <input
                    type="checkbox"
                    class="fcc2__dropdown__checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}checked{% endif %}
                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    data-fcc2-filter-input
                  >

                  <span class="fcc2__dropdown__box" aria-hidden="true">
                    <svg viewBox="0 0 14 14" width="14" height="14">
                      <polyline
                        points="2,7 6,11 12,3"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </label>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}


    {%- if filter.param_name == 'filter.p.product_type' -%}
      {%- assign formula_filter_found = true -%}

      <div class="fcc2__dropdown" data-fcc2-dropdown>
        <button
          type="button"
          class="fcc2__dropdown__toggle"
          data-fcc2-dropdown-toggle
          aria-expanded="false"
          aria-haspopup="listbox"
        >
          <span class="fcc2__dropdown__label">
            {{ section.settings.formula_type_filter_label | default: 'Formula Type' }}
          </span>

          <svg
            class="fcc2__dropdown__caret"
            viewBox="0 0 12 8"
            width="12"
            height="8"
            aria-hidden="true"
          >
            <path
              d="M1 1l5 5 5-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          class="fcc2__dropdown__panel"
          data-fcc2-dropdown-panel
          role="listbox"
        >
          <ul class="fcc2__dropdown__list">
            {%- for value in filter.values -%}
              <li class="fcc2__dropdown__item">
                <label class="fcc2__dropdown__option{% if value.count == 0 and value.active == false %} fcc2__dropdown__option--disabled{% endif %}">
                  <span class="fcc2__dropdown__option__text">
                    {{ value.label | upcase }}
                  </span>

                  <input
                    type="checkbox"
                    class="fcc2__dropdown__checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}checked{% endif %}
                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    data-fcc2-filter-input
                  >

                  <span class="fcc2__dropdown__box" aria-hidden="true">
                    <svg viewBox="0 0 14 14" width="14" height="14">
                      <polyline
                        points="2,7 6,11 12,3"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </label>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}

  {%- endfor -%}


  {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
  {%- if current_sort != blank -%}
    <input type="hidden" name="sort_by" value="{{ current_sort }}">
  {%- endif -%}


  {%- assign has_active_filters = false -%}
  {%- for filter in collection.filters -%}
    {%- if filter.active_values.size > 0 -%}
      {%- assign has_active_filters = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_active_filters -%}
    <a
      class="fcc2__clear-filters"
      href="{{ collection.url }}{% if current_sort != blank %}?sort_by={{ current_sort | url_encode }}{% endif %}"
    >
      Clear filters
    </a>
  {%- endif -%}


  <noscript>
    <button type="submit" class="fcc2__filterbar__submit">Filter</button>
  </noscript>
</form>
          
</div><div class="fcc2__content">
  <div class="fcc2__products" data-fcc2-products-grid="">
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="js-grid" data-grid-large="{{ section.settings.columns_desktop }}" data-grid-small="{{ section.settings.columns_mobile }}">
        {%- for product in collection.products -%}
          <div>
            <div class="product-grid-item" data-grid-item="">
              <div>
                <a
                  aria-label="{{ product.title | escape }}"
                  class="lazy-image double__image"
                  data-grid-link=""
                  href="{{ product.url | within: collection }}"
                  style="padding-top:100%;{% if product.featured_image %} background-image:url('{{ product.featured_image | image_url: width: 20 }}');{% endif %}"
                >
                  {%- if product.featured_image -%}
                    <div class="collection__image__top">
                      {{ product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '180,360,540,720,900',
                          sizes: '(min-width: 990px) 25vw, 50vw',
                          class: 'fcc2__product-image',
                          alt: product.featured_image.alt | default: product.title
                      }}
                    </div>
                  {%- else -%}
                    <div class="collection__image__top fcc2__image-placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}

                  {%- if product.images.size > 1 -%}
                    <div class="collection__image__bottom">
                      {{ product.images[1]
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '180,360,540,720,900',
                          sizes: '(min-width: 990px) 25vw, 50vw',
                          class: 'fcc2__product-image',
                          alt: product.images[1].alt | default: product.title
                      }}
                    </div>
                  {%- endif -%}

                  {%- unless product.available -%}
                    <span class="fcc2__badge">Sold out</span>
                  {%- endunless -%}
                  <div class="product-grid-item__slide" data-grid-slide=""></div>
                </a>
              </div>

              <div class="product__grid__info product__grid__info--under text-center" data-swapper-wrapper="">
                <a href="{{ product.url | within: collection }}">
                  <div class="product__grid__title__wrapper">
                    <p class="product__grid__title">{{ product.title }}</p>

                    {% assign judge_badge = product.metafields.judgeme.badge %}

                    {% if judge_badge != blank %}
                      <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
                        {{ judge_badge }}
                      </div>
                    {% else %}
                      <div class="jdgm-widget jdgm-preview-badge">
                        <span class="jdgm-prev-badge__stars">
                          ☆☆☆☆☆
                        </span>
                        <span class="jdgm-prev-badge__text">(0)</span>
                      </div>
                    {% endif %}
                    
                  </div>

                  <div class="product__grid__price">
                    {%- if product.price_varies -%}
                      <span class="price">From {{ product.price_min | money }}</span>
                    {%- else -%}
                      <span class="price">{{ product.price | money }}</span>
                    {%- endif -%}
                    {%- if product.compare_at_price_max > product.price -%}
                      <s class="fcc2__compare-price">{{ product.compare_at_price_max | money }}</s>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            </div>
          </div>
        {%- else -%}
          <div class="fcc2__empty">
            <p>No products found in this collection.</p>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav aria-label="Pagination" class="fcc2__pagination" role="navigation">
          {%- if paginate.previous -%}
            <a aria-label="Previous page" class="fcc2__pagination__arrow" href="{{ paginate.previous.url }}">
              <svg aria-hidden="true" height="12" viewBox="0 0 12 12" width="12"><path d="M8 2L3 6l5 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
            </a>
          {%- else -%}
            <span aria-hidden="true" class="fcc2__pagination__arrow fcc2__pagination__arrow--disabled">
              <svg height="12" viewBox="0 0 12 12" width="12"><path d="M8 2L3 6l5 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
            </span>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="fcc2__pagination__page" href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <span aria-current="page" class="fcc2__pagination__page fcc2__pagination__page--current">{{ part.title }}</span>
              {%- else -%}
                <span class="fcc2__pagination__page fcc2__pagination__page--ellipsis">{{ part.title }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a aria-label="Next page" class="fcc2__pagination__arrow" href="{{ paginate.next.url }}">
              <svg aria-hidden="true" height="12" viewBox="0 0 12 12" width="12"><path d="M4 2l5 4-5 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
            </a>
          {%- else -%}
            <span aria-hidden="true" class="fcc2__pagination__arrow fcc2__pagination__arrow--disabled">
              <svg height="12" viewBox="0 0 12 12" width="12"><path d="M4 2l5 4-5 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
            </span>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>
</div>
</div>
</div>
<style>
  .fcc2 {
    padding: 48px 0 96px;
    position: relative;
  }
  .fcc2 .wrapper { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* Hero — Figma-matched typography, text column 610px */
  .fcc2__hero { text-align: center; margin: 0 auto 48px; max-width: 610px; }
  .fcc2__hero__eyebrow {
    font-family: 'Tenor Sans', sans-serif !important;
    font-size: 24px !important;
    font-weight: 400 !important;
    line-height: 1.3 !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #13322B;
    margin: 0 0 8px;
  }
  .fcc2__hero__title {
    font-family: 'Libre Baskerville', serif !important;
    font-size: 48px !important;
    font-weight: 400 !important;
    line-height: 1.3 !important;
    letter-spacing: 0 !important;
    color: #13322B;
    margin: 0 0 24px;
  }
  .fcc2__hero__title em {
    font-style: italic;
    color: inherit;
  }
  .fcc2__hero__description {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: clamp(16px, 1.4vw, 18px) !important;
    line-height: 1.65 !important;
    color: #13322B;
    margin: 0 auto 28px;
  }
  .fcc2__hero__description p { margin: 0; font-family: inherit; font-size: inherit; line-height: inherit; color: inherit; }

  /* Live Trustpilot widget (same as original section) */
  .fcc2__hero__trustpilot-live {
    width: 100%;
    max-width: 520px;
    margin: 8px auto 0;
  }
  .fcc2__hero__trustpilot-live .trustpilot-widget iframe {
    width: 100% !important;
    display: block;
  }

  /* Filter bar (same as original section) */
  .fcc2__filterbar {
    margin: 0 0 32px;
    position: relative;
    z-index: 1;
  }
  .fcc2__filterbar__form {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  .fcc2__dropdown {
    position: relative;
    min-width: 260px;
    z-index: 1;
  }
  .fcc2__dropdown[data-fcc2-open="true"] { z-index: 100; }
  .fcc2__dropdown__toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    background: #fff;
    border: 1px solid #1c1c1c;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 500;
    color: #1c1c1c;
    cursor: pointer;
    transition: all .15s ease;
    font-family: inherit;
  }
  .fcc2__dropdown__toggle:hover { background: #fafafa; }
  .fcc2__dropdown__toggle[aria-expanded="true"] { background: #fafafa; }
  .fcc2__dropdown__toggle[aria-expanded="true"] .fcc2__dropdown__caret { transform: rotate(180deg); }
  .fcc2__dropdown__caret { transition: transform .2s ease; flex-shrink: 0; }
  .fcc2__dropdown__count { color: #6b6b6b; margin-left: 4px; font-weight: 400; }

  .fcc2__dropdown__panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid #1c1c1c;
    border-radius: 8px;
    box-shadow: 0 12px 32px rgba(0,0,0,.12);
    max-height: 360px;
    overflow-y: auto;
    z-index: 100;
    display: none;
  }
  .fcc2__dropdown[data-fcc2-open="true"] .fcc2__dropdown__panel { display: block; }

  .fcc2__dropdown__list { list-style: none; margin: 0; padding: 8px 0; }
  .fcc2__dropdown__item { margin: 0; }
  .fcc2__dropdown__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    cursor: pointer;
    font-size: 13px;
    letter-spacing: .03em;
    color: #1c1c1c;
    transition: background .12s ease;
    position: relative;
  }
  .fcc2__dropdown__option:hover { background: #f5f5f5; }
  .fcc2__dropdown__option--disabled { opacity: .4; cursor: not-allowed; }
  .fcc2__dropdown__option--disabled:hover { background: transparent; }
  .fcc2__dropdown__option__text {
    flex: 1;
    padding-right: 12px;
    font-weight: 500;
  }
  .fcc2__dropdown__checkbox {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .fcc2__dropdown__box {
    width: 18px;
    height: 18px;
    border: 1.5px solid #1c1c1c;
    border-radius: 3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    flex-shrink: 0;
    background: #fff;
    transition: all .12s ease;
  }
  .fcc2__dropdown__checkbox:checked + .fcc2__dropdown__box {
    background: #1c1c1c;
    color: #fff;
  }

  /* Tag filter uses radio buttons: only one tag can be active */
  .fcc2__dropdown__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .fcc2__dropdown__radio-dot {
    width: 18px !important;
    height: 18px !important;
    min-width: 18px !important;
    min-height: 18px !important;
    border: 1.5px solid #1c1c1c !important;
    border-radius: 50% !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #fff !important;
    box-sizing: border-box !important;
    overflow: hidden;
  }
  .fcc2__dropdown__radio-dot::after {
    content: "";
    display: block;
    width: 8px !important;
    height: 8px !important;
    border-radius: 50% !important;
    background: #1c1c1c !important;
    transform: scale(0);
    transition: transform .12s ease;
  }
  .fcc2__dropdown__radio:checked + .fcc2__dropdown__radio-dot::after {
    transform: scale(1);
  }

  .fcc2__active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin: 0 0 32px;
    position: relative;
    z-index: 1;
  }
  .fcc2__active-filters__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: #f3f3f3;
    border-radius: 999px;
    font-size: 13px;
    color: #1c1c1c;
    text-decoration: none;
    transition: background .12s ease;
  }
  .fcc2__active-filters__pill:hover { background: #e8e8e8; }
  .fcc2__active-filters__clear {
    font-size: 13px;
    text-decoration: underline;
    color: #1c1c1c;
    align-self: center;
  }

  .fcc2__filterbar__submit {
    padding: 12px 24px;
    background: #1c1c1c;
    color: #fff;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }

  .fcc2__products {
    position: relative;
    z-index: 0;
  }

  .fcc2__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 56px 0 0;
  }
  .fcc2__pagination__arrow,
  .fcc2__pagination__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    color: #1c1c1c;
    text-decoration: none;
    background: transparent;
    transition: background .12s ease;
  }
  .fcc2__pagination__arrow:hover,
  .fcc2__pagination__page:hover { background: #f3f3f3; }
  .fcc2__pagination__page--current {
    background: #1c1c1c;
    color: #fff;
    font-weight: 600;
  }
  .fcc2__pagination__page--current:hover { background: #1c1c1c; }
  .fcc2__pagination__page--ellipsis { cursor: default; color: #6b6b6b; }
  .fcc2__pagination__page--ellipsis:hover { background: transparent; }
  .fcc2__pagination__arrow--disabled { opacity: .3; cursor: not-allowed; }
  .fcc2__pagination__arrow--disabled:hover { background: transparent; }
  .fcc2__product-image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fcc2__image-placeholder { width: 100%; height: 100%; display: grid; place-items: center; background: #f7f7f3; }
  .fcc2__badge { position: absolute; top: 12px; left: 12px; z-index: 3; padding: 6px 10px; background: #13322B; color: #fff; font-size: 12px; letter-spacing: .04em; }
  .fcc2__compare-price { margin-left: 8px; opacity: .55; font-size: .9em; }
  .fcc2__empty { grid-column: 1 / -1; text-align: center; padding: 48px 20px; }

  @media (max-width: 1024px) {
    .fcc2__hero__eyebrow { font-size: 18px !important; }
    .fcc2__hero__title { font-size: 34px !important; }
  }
  .fcc2__clear-filters {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 4px;
    font-family: 'Libre Franklin', sans-serif;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 3px;
    color: inherit;
    white-space: nowrap;
  }

  .fcc2__filterbar__noscript {
    margin: 0;
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .fcc2__dropdown { min-width: 0; flex: 1 1 calc(50% - 8px); }
    .fcc2__filterbar__form { gap: 12px; }
    .fcc2__pagination__arrow,
    .fcc2__pagination__page { min-width: 32px; height: 32px; font-size: 13px; padding: 0 8px; }
  }
</style>
<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;

    var form = root.querySelector('[data-fcc2-filter-form]');
    if (!form) return;

    var dropdowns = root.querySelectorAll('[data-fcc2-dropdown]');

    function closeDropdown(dropdown) {
      if (!dropdown) return;

      dropdown.removeAttribute('data-fcc2-open');

      var toggle = dropdown.querySelector('[data-fcc2-dropdown-toggle]');
      if (toggle) {
        toggle.setAttribute('aria-expanded', 'false');
      }
    }

    function closeAllDropdowns(exceptDropdown) {
      dropdowns.forEach(function (dropdown) {
        if (dropdown !== exceptDropdown) {
          closeDropdown(dropdown);
        }
      });
    }

    dropdowns.forEach(function (dropdown) {
      var toggle = dropdown.querySelector('[data-fcc2-dropdown-toggle]');
      if (!toggle) return;

      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        var isOpen = dropdown.getAttribute('data-fcc2-open') === 'true';

        closeAllDropdowns(dropdown);

        if (isOpen) {
          closeDropdown(dropdown);
        } else {
          dropdown.setAttribute('data-fcc2-open', 'true');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', function (event) {
      if (!event.target.closest('[data-fcc2-dropdown]')) {
        closeAllDropdowns();
      }
    });

    form.addEventListener('change', function (event) {
      if (!event.target.matches('[data-fcc2-filter-input]')) return;

      /*
       * Shopify storefront filtering is GET based.
       * Submitting the form keeps every checked Age / Formula Type value.
       */
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.submit();
      }
    });
  })();
</script>
</div>
</main>
</div>
