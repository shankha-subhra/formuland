<script>
(function () {
  var root = document.getElementById('fpe-template--22898950701275__pdp_europe_main_MGmyyR');
  if (!root || root.dataset.fpeInit) return;
  root.dataset.fpeInit = '1';

  /* ---------- Data from Liquid ---------- */
  var DATA = {
    unit: "can",
    units: "cans",
    fee: parseFloat("24.99") || 0,
    freeAt: 2,
    feeInTotal: false,
    popularCans: 6,
    bestCans: 12,
    arrivalMin: 2,
    arrivalMax: 5,
    skipWeekends: true,
    klaviyoKey: "VNGdQ6",
    variants: [{
        id: 48978688934107,
        title: "1 Can (UK) - $49.99 each",
        avail: true,
        price: 4999,
        compareAt: 4199,
        allocations: []
      },{
        id: 48978688966875,
        title: "2 Cans (UK) - $49.99 each",
        avail: true,
        price: 9998,
        compareAt: 4199,
        allocations: []
      },{
        id: 42957346832603,
        title: "4 Cans (UK) - $48.99 each",
        avail: true,
        price: 19596,
        compareAt: 16796,
        allocations: [{ id: 4613341403, name: "Delivery every 1 week", price: 18224 },{ id: 4613374171, name: "Delivery every 2 weeks", price: 18224 },{ id: 4613406939, name: "Delivery every 3 weeks", price: 18224 },{ id: 4613439707, name: "Delivery every 4 weeks", price: 18224 },{ id: 4613472475, name: "Delivery every 5 weeks", price: 18224 },{ id: 4613505243, name: "Delivery every 6 weeks", price: 18224 },{ id: 6374818011, name: "Delivery every 2 months", price: 18224 },{ id: 6374850779, name: "Delivery every 3 months", price: 18224 },]
      },{
        id: 42957346865371,
        title: "6 Cans (UK) - $47.99 each",
        avail: true,
        price: 28794,
        compareAt: 33592,
        allocations: [{ id: 4613341403, name: "Delivery every 1 week", price: 26778 },{ id: 4613374171, name: "Delivery every 2 weeks", price: 26778 },{ id: 4613406939, name: "Delivery every 3 weeks", price: 26778 },{ id: 4613439707, name: "Delivery every 4 weeks", price: 26778 },{ id: 4613472475, name: "Delivery every 5 weeks", price: 26778 },{ id: 4613505243, name: "Delivery every 6 weeks", price: 26778 },{ id: 6374818011, name: "Delivery every 2 months", price: 26778 },{ id: 6374850779, name: "Delivery every 3 months", price: 26778 },]
      },{
        id: 42957346898139,
        title: "12 Cans (UK) - $45.99 each",
        avail: true,
        price: 55188,
        compareAt: 50388,
        allocations: [{ id: 4613341403, name: "Delivery every 1 week", price: 51325 },{ id: 4613374171, name: "Delivery every 2 weeks", price: 51325 },{ id: 4613406939, name: "Delivery every 3 weeks", price: 51325 },{ id: 4613439707, name: "Delivery every 4 weeks", price: 51325 },{ id: 4613472475, name: "Delivery every 5 weeks", price: 51325 },{ id: 4613505243, name: "Delivery every 6 weeks", price: 51325 },{ id: 6374818011, name: "Delivery every 2 months", price: 51325 },{ id: 6374850779, name: "Delivery every 3 months", price: 51325 },]
      },]
  };

  /* ---------- Helpers ---------- */
  function money(cents) { return '$' + (Math.round(cents) / 100).toFixed(2); }
  function cansOf(v) {
    var m = v.title.match(/\d+/);
    return m ? parseInt(m[0], 10) : 1;
  }
  function q(sel) { return root.querySelector(sel); }
  function qa(sel) { return Array.prototype.slice.call(root.querySelectorAll(sel)); }

  DATA.variants.forEach(function (v) { v.cans = cansOf(v); });

  /* Show every variant (sold-out ones included, per Bruce) */
  var oneVariants = DATA.variants.slice();
  oneVariants.sort(function (a, b) { return a.cans - b.cans; });
  var availOne = oneVariants.filter(function (v) { return v.avail; });

  var subVariants = oneVariants.filter(function (v) { return v.avail && v.allocations.length > 0; });

  /* Savings baseline: per-can price of the 1-can variant, else the highest per-can */
  var baselinePer = 0;
  var oneCanVariant = null;
  oneVariants.forEach(function (v) {
    var per = v.price / v.cans;
    if (v.cans === 1 && !oneCanVariant) oneCanVariant = v;
    if (per > baselinePer) baselinePer = per;
  });
  if (oneCanVariant) baselinePer = oneCanVariant.price;

  /* ---------- State ---------- */
  var state = {
    plan: 'one',
    subId: null,
    oneId: null,
    planId: null
  };
  if (subVariants.length) {
    var def = subVariants.filter(function (v) { return v.cans === 6; })[0];
    state.subId = (def || subVariants[Math.floor(subVariants.length / 2)] || subVariants[0]).id;
  }
  state.oneId = ((availOne[0] || oneVariants[0]) || {}).id;

  function findVariant(id) {
    return DATA.variants.filter(function (v) { return v.id === id; })[0];
  }
  function weeksOf(name) {
    var m = name.match(/(\d+)\s*week/i);
    return m ? parseInt(m[1], 10) : null;
  }
  function recommendedWeeks(cans) {
    return Math.min(10, Math.max(1, Math.round(cans / 1.5)));
  }
  function pickPlan(variant) {
    if (!variant || !variant.allocations.length) return null;
    var rec = recommendedWeeks(variant.cans);
    var best = variant.allocations[0];
    var bestDist = Infinity;
    variant.allocations.forEach(function (a) {
      var w = weeksOf(a.name);
      var dist = (w === null) ? 999 : Math.abs(w - rec);
      if (dist < bestDist) { bestDist = dist; best = a; }
    });
    return best;
  }

  /* ---------- Arrival window ---------- */
  (function arrival() {
    var el = q('[data-fpe-arrival]');
    if (!el) return;
    function addDays(base, n, skipWknd) {
      var d = new Date(base.getTime());
      if (!skipWknd) { d.setDate(d.getDate() + n); return d; }
      var added = 0;
      while (added < n) {
        d.setDate(d.getDate() + 1);
        var day = d.getDay();
        if (day !== 0 && day !== 6) added++;
      }
      return d;
    }
    var now = new Date();
    var from = addDays(now, DATA.arrivalMin, DATA.skipWeekends);
    var to = addDays(now, DATA.arrivalMax, DATA.skipWeekends);
    var opts = { weekday: 'short', month: 'short', day: 'numeric' };
    el.textContent = from.toLocaleDateString('en-US', opts) + ' \u2013 ' + to.toLocaleDateString('en-US', opts);
  })();

  /* ---------- Renderers ---------- */
  var els = {
    subRow: q('[data-fpe-plan-row="sub"]'),
    oneRow: q('[data-fpe-plan-row="one"]'),
    subTitle: q('[data-fpe-sub-title]'),
    subStrike: q('[data-fpe-sub-strike]'),
    subPer: q('[data-fpe-sub-per]'),
    subTotal: q('[data-fpe-sub-total]'),
    onePer: q('[data-fpe-one-per]'),
    oneShip: q('[data-fpe-one-ship]'),
    subTiles: q('[data-fpe-sub-tiles]'),
    oneTiles: q('[data-fpe-one-tiles]'),
    cadence: q('[data-fpe-cadence]'),
    saveline: q('[data-fpe-saveline]'),
    savelineText: q('[data-fpe-saveline-text]'),
    nudge: q('[data-fpe-nudge]'),
    nudgeText: q('[data-fpe-nudge-text]'),
    nudgeBtn: q('[data-fpe-addcan]'),
    freenote: q('[data-fpe-freenote]'),
    grand: q('[data-fpe-grand]'),
    compare: q('[data-fpe-compare]'),
    savechip: q('[data-fpe-savechip]'),
    pricesub: q('[data-fpe-pricesub]'),
    cta: q('[data-fpe-cta]'),
    ctaText: q('[data-fpe-cta-text]'),
    idInput: q('[data-fpe-id]'),
    planInput: q('[data-fpe-plan]'),
    errors: q('[data-fpe-errors]'),
    form: q('[data-fpe-form], form[id^="fpe-form-"]'),
    bisSlot: q('[data-fpe-bis-slot]'),
    gwNotify: q('[data-fpe-gw-notify]'),
    mobilebar: q('[data-fpe-mobilebar]'),
    mbPrice: q('[data-fpe-mb-price]'),
    mbCta: q('[data-fpe-mb-cta]')
  };

  function tileHTML(v, price, saveTxt, active) {
    var badge = '';
    if (v.cans === DATA.popularCans) badge = '<span class="fpe__tile-badge">Most popular</span>';
    else if (v.cans === DATA.bestCans) badge = '<span class="fpe__tile-badge fpe__tile-badge--alt">Best value</span>';
    var label = v.cans === 1 ? '1 ' + DATA.unit : v.cans + ' ' + DATA.units;
    var oos = !v.avail;
    return '<button type="button" class="fpe__tile' + (active ? ' is-active' : '') + (oos ? ' is-soldout' : '') + '" data-vid="' + v.id + '">' +
      (oos ? '' : badge) +
      '<span class="fpe__tile-label">' + label + '</span>' +
      '<span class="fpe__tile-per">' + money(price / v.cans) + '/' + DATA.unit + '</span>' +
      (oos ? '<span class="fpe__tile-save fpe__tile-oos">Sold out</span>' : (saveTxt ? '<span class="fpe__tile-save">' + saveTxt + '</span>' : '')) +
      '</button>';
  }

  function render() {
    var isSub = state.plan === 'sub';
    var subV = findVariant(state.subId);
    var oneV = findVariant(state.oneId);

    /* Row active states */
    if (els.subRow) {
      els.subRow.style.display = subVariants.length ? '' : 'none';
      els.subRow.classList.toggle('is-active', isSub);
    }
    els.oneRow.classList.toggle('is-active', !isSub);

    /* ----- Subscribe row ----- */
    if (subVariants.length && subV) {
      var planAlloc = null;
      subV.allocations.forEach(function (a) { if (a.id === state.planId) planAlloc = a; });
      if (!planAlloc) { planAlloc = pickPlan(subV); state.planId = planAlloc ? planAlloc.id : null; }

      var subPrice = planAlloc ? planAlloc.price : subV.price;
      var subPer = subPrice / subV.cans;
      var discPct = Math.round((1 - subPrice / subV.price) * 100);
      var savePct = baselinePer > 0 ? Math.round((1 - subPer / baselinePer) * 100) : 0;

      els.subTitle.textContent = 'Subscribe & save' + (discPct > 0 ? ' ' + discPct + '%' : '');
      els.subStrike.textContent = baselinePer > 0 && savePct > 0 ? money(baselinePer) + '/' + DATA.unit : '';
      els.subPer.textContent = money(subPer) + '/' + DATA.unit;
      els.subTotal.textContent = (savePct > 0 ? 'Save ' + savePct + '% · ' : '') + 'Total ' + money(subPrice);

      var compareTotal = baselinePer * subV.cans;
      var saved = compareTotal - subPrice;
      if (saved > 50) {
        els.saveline.style.display = '';
        els.savelineText.innerHTML = 'You save <strong>' + money(saved) + '</strong> on this order — ' +
          savePct + '% off the ' + money(baselinePer) + ' single-' + DATA.unit + ' price.';
      } else {
        els.saveline.style.display = 'none';
      }

      /* Sub tiles */
      var subHtml = '';
      subVariants.forEach(function (v) {
        var a = pickPlanFixed(v, state.planId) || pickPlan(v);
        var p = a ? a.price : v.price;
        var per = p / v.cans;
        var sp = baselinePer > 0 ? Math.round((1 - per / baselinePer) * 100) : 0;
        subHtml += tileHTML(v, p, sp > 0 ? 'Save ' + sp + '%' : '', v.id === state.subId);
      });
      els.subTiles.innerHTML = subHtml;

      /* Cadence options */
      var rec = recommendedWeeks(subV.cans);
      var cadHtml = '';
      subV.allocations.forEach(function (a) {
        var w = weeksOf(a.name);
        var isRec = (w !== null && w === rec) || (planAlloc && a.id === planAlloc.id && w === null);
        cadHtml += '<option value="' + a.id + '"' + (planAlloc && a.id === planAlloc.id ? ' selected' : '') + '>' +
          a.name + (w !== null && w === rec ? ' \u2014 Recommended for ' + subV.cans + ' ' + DATA.units : '') + '</option>';
      });
      els.cadence.innerHTML = cadHtml;
    }

    /* ----- One-time row ----- */
    if (oneV) {
      var belowFree = oneV.cans < DATA.freeAt;
      var onePer2 = oneV.price / oneV.cans;
      els.onePer.textContent = money(onePer2) + '/' + DATA.unit;
      els.oneShip.textContent = !oneV.avail ? 'Sold out'
        : (belowFree && DATA.fee > 0 ? '+ ' + money(DATA.fee * 100) + ' shipping' : 'Free shipping');

      var oneHtml = '';
      oneVariants.forEach(function (v) {
        oneHtml += tileHTML(v, v.price, '', v.id === state.oneId);
      });
      els.oneTiles.innerHTML = oneHtml;

      var freeTarget = availOne.filter(function (v) { return v.cans >= DATA.freeAt; })[0];
      if (oneV.avail && belowFree && DATA.fee > 0 && freeTarget) {
        /* Copy follows the free-shipping rule (per Bruce's table). The jump
           lands on the exact threshold variant once it exists, otherwise the
           next bundle up until those variants are created in admin. */
        var need = DATA.freeAt - oneV.cans;
        var lead = oneV.cans === 1
          ? 'A single ' + DATA.unit + ' ships for <strong>' + money(DATA.fee * 100) + '</strong>. '
          : '';
        var addTxt = need === 1 ? 'one more' : need + ' more';
        els.nudgeText.innerHTML = lead + 'Add ' + addTxt + ' and your whole order ships <strong>free</strong>.';
        els.nudgeBtn.textContent = need === 1 ? 'Add a ' + DATA.unit : 'Make it ' + DATA.freeAt;
        els.nudge.style.display = '';
        els.freenote.style.display = 'none';
      } else {
        els.nudge.style.display = 'none';
        /* Below threshold with no reachable bundle: fee still applies, so
           never contradict it with the free-shipping footnote. */
        els.freenote.style.display = (!oneV.avail || (belowFree && DATA.fee > 0)) ? 'none' : '';
      }
    }

    /* ----- Totals / CTA / form ----- */
    var activeV = isSub ? subV : oneV;
    if (!activeV) return;

    var total, sub, compare = 0;
    if (isSub) {
      var a2 = null;
      activeV.allocations.forEach(function (x) { if (x.id === state.planId) a2 = x; });
      total = a2 ? a2.price : activeV.price;
      compare = baselinePer * activeV.cans;
      var freqTxt = a2 ? a2.name.toLowerCase() : 'on your schedule';
      sub = money(total / activeV.cans) + '/' + DATA.unit + ' · billed ' + freqTxt + ' · free shipping';
    } else {
      var below = activeV.cans < DATA.freeAt;
      var feeCents = below ? DATA.fee * 100 : 0;
      total = activeV.price + (DATA.feeInTotal ? feeCents : 0);
      compare = activeV.cans > 1 ? baselinePer * activeV.cans : 0;
      sub = money(activeV.price / activeV.cans) + '/' + DATA.unit + ' · one-time · ' +
        (below && DATA.fee > 0 ? '+ ' + money(feeCents) + ' shipping' : 'free shipping');
    }

    els.grand.textContent = money(total);
    var savedTot = compare - total;
    if (compare > 0 && savedTot > 50) {
      els.compare.style.display = '';
      els.compare.textContent = money(compare);
      els.savechip.style.display = '';
      els.savechip.textContent = 'You save ' + money(savedTot);
    } else {
      els.compare.style.display = 'none';
      els.savechip.style.display = 'none';
    }
    els.pricesub.textContent = sub;

    var ctaLabel = activeV.avail
      ? (isSub ? 'Subscribe — ' + money(total) : 'Add to cart — ' + money(total))
      : 'Notify me when available';
    els.ctaText.textContent = ctaLabel;
    els.cta.disabled = false;
    if (els.mbPrice) els.mbPrice.textContent = money(total);
    if (els.mbCta) {
      els.mbCta.textContent = activeV.avail ? (isSub ? 'Subscribe' : 'Add to cart') : 'Notify me';
      els.mbCta.disabled = false;
    }

    /* Back-in-stock handoff: our rendered app button (gw) replaces the CTA
       when the active variant is sold out. Keep its variant id in sync so the
       app subscribes the customer to the right bundle. The slot-injected
       button remains as a fallback only if the rendered one is missing. */
    if (els.gwNotify) {
      els.gwNotify.setAttribute('data-variant-id', String(activeV.id));
      /* Seed visibility is class-driven (CSS !important) so the app's script
         cannot hide it by mirroring inline styles. The app's adopted clone in
         .gw-button-widget-container stays hidden (CSS) and serves purely as
         the bound click-relay target; keep its variant id in sync. */
      els.gwNotify.classList.toggle('is-bis', !activeV.avail);
      var gwClone = els.form ? els.form.querySelector('.gw-button-widget-container .gw-button-widget') : null;
      if (gwClone && gwClone !== els.gwNotify) {
        gwClone.setAttribute('data-variant-id', String(activeV.id));
      }
    }
    var slotHasApp = els.bisSlot && els.bisSlot.children.length > 0;
    var bisHandoff = !activeV.avail && (els.gwNotify || slotHasApp);
    els.cta.style.display = bisHandoff ? 'none' : '';
    if (els.bisSlot) els.bisSlot.style.display = (!activeV.avail && !els.gwNotify) ? '' : 'none';

    /* Hidden inputs */
    var prevId = els.idInput.value;
    els.idInput.value = activeV.id;
    if (String(prevId) !== String(activeV.id)) {
      /* Notify variant-watching apps (back-in-stock, analytics) */
      try { els.idInput.dispatchEvent(new Event('change', { bubbles: true })); } catch (e) {}
    }
    if (isSub && state.planId) {
      els.planInput.value = state.planId;
      els.planInput.disabled = false;
    } else {
      els.planInput.value = '';
      els.planInput.disabled = true;
    }
  }

  /* For sub tiles: keep the chosen frequency if that plan id exists on the tile variant */
  function pickPlanFixed(variant, planId) {
    var found = null;
    variant.allocations.forEach(function (a) { if (a.id === planId) found = a; });
    return found;
  }

  /* ---------- Events ---------- */
  qa('[data-fpe-select-plan]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      state.plan = btn.getAttribute('data-fpe-select-plan');
      render();
    });
  });

  root.addEventListener('click', function (e) {
    var tile = e.target.closest('.fpe__tile');
    if (!tile || !root.contains(tile)) return;
    var vid = parseInt(tile.getAttribute('data-vid'), 10);
    if (tile.closest('[data-fpe-sub-tiles]')) {
      state.plan = 'sub';
      state.subId = vid;
      var nv = findVariant(vid);
      var keep = pickPlanFixed(nv, state.planId);
      if (!keep) state.planId = (pickPlan(nv) || {}).id || null;
    } else {
      state.plan = 'one';
      state.oneId = vid;
    }
    render();
  });

  if (els.cadence) {
    els.cadence.addEventListener('change', function () {
      state.planId = parseInt(els.cadence.value, 10);
      render();
    });
  }

  var addCanBtn = q('[data-fpe-addcan]');
  if (addCanBtn) {
    addCanBtn.addEventListener('click', function () {
      var target = availOne.filter(function (v) { return v.cans >= DATA.freeAt; })[0] ||
                   availOne.filter(function (v) { return v.cans > 1; })[0];
      if (target) { state.oneId = target.id; render(); }
    });
  }

  /* ---------- Add to cart (fetch → FCD drawer intercept auto-opens) ---------- */
  function showError(msg) {
    els.errors.textContent = msg;
    els.errors.style.display = 'block';
  }
  function submitAdd() {
    var activeNow = findVariant(parseInt(els.idInput.value, 10));
    if (activeNow && !activeNow.avail) { triggerNotify(activeNow); return; }
    els.errors.style.display = 'none';
    els.cta.classList.add('is-loading');
    var body = new FormData(els.form);
    fetch('/cart/add.js', { method: 'POST', body: body })
      .then(function (r) {
        if (!r.ok) return r.json().then(function (j) { throw new Error(j.description || 'Could not add to cart.'); });
        return r.json();
      })
      .then(function () {
        els.cta.classList.remove('is-loading');
      })
      .catch(function (err) {
        els.cta.classList.remove('is-loading');
        showError(err.message || 'Could not add to cart. Please try again.');
      });
  }
  if (els.form) {
    els.form.addEventListener('submit', function (e) {
      e.preventDefault();
      submitAdd();
    });
  }
  if (els.mbCta) {
    els.mbCta.addEventListener('click', function () { submitAdd(); });
  }

  /* ---------- Mobile bar visibility ---------- */
  if (els.mobilebar && els.cta && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        els.mobilebar.classList.toggle('is-visible', !entry.isIntersecting);
      });
    }, { threshold: 0.05 });
    io.observe(els.cta);
  }

  /* ---------- Gallery ---------- */
  var stage = q('[data-fpe-stage]');
  var thumbs = qa('[data-fpe-thumb]');
  var galleryImgs = thumbs.length
    ? thumbs.map(function (t) { return t.getAttribute('data-zoom') || t.getAttribute('data-full'); })
    : (stage ? [stage.src] : []);
  var galleryIndex = 0;

  thumbs.forEach(function (thumb, i) {
    thumb.addEventListener('click', function () {
      if (!stage) return;
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      thumb.classList.add('is-active');
      galleryIndex = i;
      stage.style.opacity = '0';
      var full = thumb.getAttribute('data-full');
      var swap = new Image();
      swap.onload = function () { stage.src = full; stage.style.opacity = '1'; };
      swap.src = full;
    });
  });

  /* Click-to-zoom lightbox */
  function openLightbox(startIndex) {
    if (!galleryImgs.length) return;
    var idx = startIndex;
    var overlay = document.createElement('div');
    overlay.className = 'fpe__lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-label', 'Image zoom');
    var frame = document.createElement('div');
    frame.className = 'fpe__lightbox-frame';
    var img = document.createElement('img');
    img.src = galleryImgs[idx];
    img.alt = "HiPP UK Organic Stage 2 from 6 Months (800g)";
    frame.appendChild(img);
    overlay.appendChild(frame);
    var close = document.createElement('button');
    close.type = 'button';
    close.className = 'fpe__lightbox-close';
    close.innerHTML = '&times;';
    close.setAttribute('aria-label', 'Close');
    overlay.appendChild(close);
    var prev, next;
    /* ----- Stepped zoom ----- */
    var LEVELS = [1, 1.6, 2.4, 3.2, 4];
    var level = 0;
    var zoomBar = document.createElement('div');
    zoomBar.className = 'fpe__lightbox-zoom';
    var zOut = document.createElement('button');
    zOut.type = 'button'; zOut.innerHTML = '&minus;'; zOut.setAttribute('aria-label', 'Zoom out');
    var zLabel = document.createElement('span');
    var zIn = document.createElement('button');
    zIn.type = 'button'; zIn.innerHTML = '+'; zIn.setAttribute('aria-label', 'Zoom in');
    zoomBar.appendChild(zOut); zoomBar.appendChild(zLabel); zoomBar.appendChild(zIn);
    overlay.appendChild(zoomBar);
    zoomBar.addEventListener('click', function (e) { e.stopPropagation(); });

    function applyZoom() {
      var s = LEVELS[level];
      img.style.transform = 'scale(' + s + ')';
      img.classList.toggle('is-zoomed', level > 0);
      if (level === 0) img.style.transformOrigin = 'center center';
      zLabel.textContent = Math.round(s * 100) + '%';
      zOut.disabled = level === 0;
      zIn.disabled = level === LEVELS.length - 1;
    }
    function setOrigin(cx, cy) {
      var r = frame.getBoundingClientRect();
      var x = ((cx - r.left) / r.width) * 100;
      var y = ((cy - r.top) / r.height) * 100;
      img.style.transformOrigin = Math.max(0, Math.min(100, x)) + '% ' + Math.max(0, Math.min(100, y)) + '%';
    }
    zIn.addEventListener('click', function () {
      if (level < LEVELS.length - 1) { level++; applyZoom(); }
    });
    zOut.addEventListener('click', function () {
      if (level > 0) { level--; applyZoom(); }
    });

    function show(i) {
      idx = (i + galleryImgs.length) % galleryImgs.length;
      level = 0;
      applyZoom();
      img.src = galleryImgs[idx];
    }
    /* While zoomed, the view follows the cursor / finger */
    img.addEventListener('mousemove', function (e) {
      if (level > 0) setOrigin(e.clientX, e.clientY);
    });
    img.addEventListener('touchmove', function (e) {
      if (level > 0 && e.touches.length === 1) {
        setOrigin(e.touches[0].clientX, e.touches[0].clientY);
        e.preventDefault();
      }
    }, { passive: false });
    applyZoom();
    if (galleryImgs.length > 1) {
      prev = document.createElement('button');
      prev.type = 'button';
      prev.className = 'fpe__lightbox-nav fpe__lightbox-nav--prev';
      prev.innerHTML = '&#8249;';
      prev.setAttribute('aria-label', 'Previous image');
      next = document.createElement('button');
      next.type = 'button';
      next.className = 'fpe__lightbox-nav fpe__lightbox-nav--next';
      next.innerHTML = '&#8250;';
      next.setAttribute('aria-label', 'Next image');
      overlay.appendChild(prev);
      overlay.appendChild(next);
      prev.addEventListener('click', function (e) { e.stopPropagation(); show(idx - 1); });
      next.addEventListener('click', function (e) { e.stopPropagation(); show(idx + 1); });
    }
    function destroy() {
      document.removeEventListener('keydown', onKey);
      document.body.style.overflow = '';
      if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
    }
    function onKey(e) {
      if (e.key === 'Escape') destroy();
      if (e.key === 'ArrowLeft' && galleryImgs.length > 1) show(idx - 1);
      if (e.key === 'ArrowRight' && galleryImgs.length > 1) show(idx + 1);
    }
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay || e.target === close) destroy();
    });
    img.addEventListener('click', function (e) {
      e.stopPropagation();
      if (level === 0) {
        setOrigin(e.clientX, e.clientY);
        level = 2; /* jump straight to 240% */
      } else {
        level = 0;
      }
      applyZoom();
    });
    document.addEventListener('keydown', onKey);
    document.body.style.overflow = 'hidden';
    document.body.appendChild(overlay);
  }
  if (stage) {
    stage.addEventListener('click', function () { openLightbox(galleryIndex); });
  }

  /* ---------- Back-in-stock notify (Klaviyo) ---------- */
  var notifyEls = {
    root: q('[data-fpe-notify]'),
    close: q('[data-fpe-notify-close]'),
    variant: q('[data-fpe-notify-variant]'),
    tabs: qa('[data-fpe-channel]'),
    email: q('[data-fpe-notify-email]'),
    phone: q('[data-fpe-notify-phone]'),
    submit: q('[data-fpe-notify-submit]'),
    msg: q('[data-fpe-notify-msg]')
  };
  var notifyState = { channel: 'email', variantId: null };

  /* ---------- gw (Kbite) relay ----------
     The app's script runs on this page (it creates .gw-button-widget-container
     next to the add button) but binds click handlers only to buttons IT
     injects — not to ours. So our rendered button relays: on click, find the
     app's own injected button, sync the variant onto it, and click it. If no
     app UI becomes visible, open the built-in modal as the safety net. */
  function findAppBisButton() {
    var cands = document.querySelectorAll(
      '.gw-button-widget-container .gw-button-widget, ' +
      '.gw-button-widget-container button, ' +
      '.gw-button-widget-container a, ' +
      '.gw-button-widget'
    );
    for (var i = 0; i < cands.length; i++) {
      if (cands[i] !== els.gwNotify) return cands[i];
    }
    return null;
  }
  function gwOverlayVisible() {
    /* Any visible gw-* element OUTSIDE the buy-box form = the app's popup. */
    var cands = document.querySelectorAll('[class*="gw-"], [id*="gw"]');
    for (var i = 0; i < cands.length; i++) {
      var el = cands[i];
      if (el === els.gwNotify) continue;
      if (els.form && els.form.contains(el)) continue;
      /* getClientRects also catches position:fixed overlays (offsetParent is
         null for those). */
      if (el.getClientRects().length > 0) return true;
    }
    return false;
  }
  if (els.gwNotify) {
    els.gwNotify.addEventListener('click', function () {
      var vid = parseInt(els.gwNotify.getAttribute('data-variant-id'), 10);
      var variant = findVariant(vid);
      var appBtn = findAppBisButton();
      if (appBtn) {
        try {
          appBtn.setAttribute('data-variant-id', String(vid));
          if (appBtn.getAttribute('data-product-id') == null) {
            appBtn.setAttribute('data-product-id', els.gwNotify.getAttribute('data-product-id'));
            appBtn.setAttribute('data-product-handle', els.gwNotify.getAttribute('data-product-handle'));
          }
        } catch (e) {}
        appBtn.click();
      }
      /* When the app's bound button exists, its popup fully owns the click —
         no fallback, so only one popup ever shows. The built-in modal is the
         safety net solely when the app never adopted (script missing). */
      if (appBtn) return;
      setTimeout(function () {
        if (gwOverlayVisible()) return;
        if (variant && notifyEls.root && notifyEls.root.hidden) openNotify(variant);
      }, 350);
    });
  }

  function triggerNotify(variant) {
    /* Preference order:
       0. Our rendered app button (gw) — clicking it opens the app's popup.
          If nothing visible appears (app script absent/unbound), fall through
          to the built-in modal so the customer is never stranded.
       1. The store's back-in-stock app button (Kbite) if it injected one
          into our slot — clicking it opens the app's own modal.
       2. Klaviyo's back-in-stock widget via its trigger, if present.
       3. The built-in modal, so the customer is never stranded. */
    if (els.gwNotify) {
      els.gwNotify.setAttribute('data-variant-id', String(variant.id));
      els.gwNotify.click(); /* routed through the relay click handler */
      return;
    }
    if (els.bisSlot && els.bisSlot.children.length > 0) {
      var appBtn = els.bisSlot.querySelector('button, a, [role="button"]');
      if (appBtn) { appBtn.click(); return; }
    }
    var trig = q('[data-fpe-bis-trigger]');
    if (trig) {
      trig.click();
      setTimeout(function () {
        var theirs = document.querySelector('[class*="klaviyo-bis"]:not([data-fpe-bis-trigger]), [id*="klaviyo-bis"], iframe[src*="klaviyo"]');
        var visible = theirs && theirs.offsetParent !== null;
        if (!visible && notifyEls.root && notifyEls.root.hidden) openNotify(variant);
      }, 700);
      return;
    }
    openNotify(variant);
  }

  function openNotify(variant) {
    if (!notifyEls.root) return;
    notifyState.variantId = variant.id;
    var label = variant.cans === 1 ? '1 ' + DATA.unit : variant.cans + ' ' + DATA.units;
    notifyEls.variant.textContent = "HiPP UK Organic Stage 2 from 6 Months (800g)" + ' — ' + label;
    notifyEls.msg.className = 'fpe__notify-msg';
    notifyEls.msg.textContent = '';
    notifyEls.root.hidden = false;
    document.body.style.overflow = 'hidden';
    (notifyState.channel === 'email' ? notifyEls.email : notifyEls.phone).focus();
  }
  function closeNotify() {
    if (!notifyEls.root) return;
    notifyEls.root.hidden = true;
    document.body.style.overflow = '';
  }
  if (notifyEls.root) {
    notifyEls.close.addEventListener('click', closeNotify);
    notifyEls.root.addEventListener('click', function (e) {
      if (e.target === notifyEls.root) closeNotify();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !notifyEls.root.hidden) closeNotify();
    });
    notifyEls.tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        notifyState.channel = tab.getAttribute('data-fpe-channel');
        notifyEls.tabs.forEach(function (t) { t.classList.toggle('is-active', t === tab); });
        notifyEls.email.style.display = notifyState.channel === 'email' ? '' : 'none';
        notifyEls.phone.style.display = notifyState.channel === 'sms' ? '' : 'none';
      });
    });
    notifyEls.submit.addEventListener('click', function () {
      var isEmail = notifyState.channel === 'email';
      var val = (isEmail ? notifyEls.email.value : notifyEls.phone.value).trim();
      notifyEls.msg.className = 'fpe__notify-msg';
      if (isEmail && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val)) {
        notifyEls.msg.textContent = 'Please enter a valid email address.';
        notifyEls.msg.classList.add('is-err');
        return;
      }
      if (!isEmail && !/^\+[0-9 ()-]{7,}$/.test(val)) {
        notifyEls.msg.textContent = 'Please enter your phone number with country code, e.g. +1 555 555 5555.';
        notifyEls.msg.classList.add('is-err');
        return;
      }
      if (!DATA.klaviyoKey) {
        notifyEls.msg.textContent = 'Notifications are not configured yet. Please contact support.';
        notifyEls.msg.classList.add('is-err');
        return;
      }
      var profileAttrs = isEmail ? { email: val } : { phone_number: val.replace(/[ ()-]/g, '') };
      var payload = {
        data: {
          type: 'back-in-stock-subscription',
          attributes: {
            profile: { data: { type: 'profile', attributes: profileAttrs } },
            channels: [isEmail ? 'EMAIL' : 'SMS']
          },
          relationships: {
            variant: { data: { type: 'catalog-variant', id: '$shopify:::$default:::' + notifyState.variantId } }
          }
        }
      };
      notifyEls.submit.disabled = true;
      fetch('https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=' + encodeURIComponent(DATA.klaviyoKey), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
        body: JSON.stringify(payload)
      })
        .then(function (r) {
          notifyEls.submit.disabled = false;
          if (r.ok || r.status === 202) {
            notifyEls.msg.textContent = "You're on the list — we'll let you know the moment it's back.";
            notifyEls.msg.classList.add('is-ok');
            notifyEls.email.value = '';
            notifyEls.phone.value = '';
          } else {
            notifyEls.msg.textContent = 'Something went wrong. Please try again.';
            notifyEls.msg.classList.add('is-err');
          }
        })
        .catch(function () {
          notifyEls.submit.disabled = false;
          notifyEls.msg.textContent = 'Something went wrong. Please try again.';
          notifyEls.msg.classList.add('is-err');
        });
    });
  }

  /* ---------- Suppress the Appstle widget on this template ---------- */
  var appstleTimer = setInterval(function () {
    var w = document.querySelector('#appstle_subscription_widget0');
    if (w) { clearInterval(appstleTimer); w.innerHTML = ''; }
  }, 100);
  setTimeout(function () { clearInterval(appstleTimer); }, 5000);

  /* The app adopts the seed asynchronously after page load — re-run render
     once its clone appears so visibility/variant sync apply to the clone. */
  if (els.gwNotify && els.form && 'MutationObserver' in window) {
    var gwMo = new MutationObserver(function () {
      if (els.form.querySelector('.gw-button-widget-container .gw-button-widget')) {
        gwMo.disconnect();
        render();
      }
    });
    gwMo.observe(els.form, { childList: true, subtree: true });
    setTimeout(function () { gwMo.disconnect(); }, 15000);
  }

  render();
})();
