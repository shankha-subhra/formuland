{% assign prep_tips = collection.metafields.custom.preparation_tips.value %}
{% if prep_tips != blank %}
<section class="shopify-section fcc-prep-section" id="shopify-section-{{ section.id }}">
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&amp;family=Libre+Franklin:wght@400;500;600&amp;family=Tenor+Sans&amp;display=swap" rel="stylesheet"/>
<style data-shopify="">
  #fcc-prep-{{ section.id }} {
    position: relative;
    background-color: #e7f1fb;
    padding: 150px 24px 150px;
    overflow: hidden;
  }

  /* Section background image */
  #fcc-prep-{{ section.id }} .fcc-prep__section-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__section-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.7;
  }

  #fcc-prep-{{ section.id }} .fcc-prep__wrap {
    position: relative;
    z-index: 1;
    max-width: 1360px;
    margin: 0 auto;
  }

  /* Header */
  #fcc-prep-{{ section.id }} .fcc-prep__header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 40px;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__header-text { max-width: 680px; }

  #fcc-prep-{{ section.id }} .fcc-prep__subheading {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #4a2b29;
    margin: 0 0 16px;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__heading {
    font-family: 'Libre Baskerville', serif !important;
    font-weight: 400 !important;
    font-size: 40px !important;
    line-height: 1.3 !important;
    color: #4a2b29;
    margin: 0 0 24px;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__heading em {
    font-style: italic;
    color: inherit;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__description {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: clamp(16px, 1.4vw, 18px) !important;
    line-height: 1.65 !important;
    color: #4a2b29;
    margin: 0;
  }

  /* Round arrows */
  #fcc-prep-{{ section.id }} .fcc-prep__controls {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__arrow {
    background: transparent;
    border: 1px solid #4a2b29;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    padding: 0;
    cursor: pointer;
    color: #4a2b29;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__arrow:hover:not([disabled]) {
    background: #4a2b29;
    color: #e7f1fb;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__arrow svg {
    width: 20px;
    height: 20px;
  }

  /* Slider */
  #fcc-prep-{{ section.id }} .fcc-prep__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 24px;
    padding-bottom: 24px;
    margin-bottom: 32px;
    scrollbar-width: none;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__grid::-webkit-scrollbar { display: none; }
  #fcc-prep-{{ section.id }} .fcc-prep__card {
    scroll-snap-align: start;
    flex: 0 0 calc(22.5% - 18px);
    background-color: #fbfbf8;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }

  /* Card content */
  #fcc-prep-{{ section.id }} .fcc-prep__card-num {
    font-family: 'Tenor Sans', sans-serif !important;
    font-size: 18px !important;
    font-weight: 400 !important;
    color: #4a2b29;
    margin: 0 0 24px;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__card-title {
    font-family: 'Tenor Sans', sans-serif !important;
    font-size: 22px !important;
    font-weight: 400 !important;
    line-height: 1.4 !important;
    color: #4a2b29;
    margin: 0 0 16px;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__card-desc {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 16px !important;
    line-height: 1.6 !important;
    color: #4a2b29;
    margin: 0;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__card-desc p {
    margin: 0;
  }

  /* CTA button */
  #fcc-prep-{{ section.id }} .fcc-prep__btn {
    display: inline-block;
    padding: 14px 32px;
    border: 1px solid #4a2b29;
    color: #4a2b29;
    text-decoration: none;
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color 0.3s ease, color 0.3s ease;
    background: transparent;
  }
  #fcc-prep-{{ section.id }} .fcc-prep__btn:hover {
    background-color: #4a2b29;
    color: #FFFFFF;
  }

  /* Tablet & mobile */
  @media (max-width: 1024px) {
    #fcc-prep-{{ section.id }} .fcc-prep__header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }
    #fcc-prep-{{ section.id }} .fcc-prep__heading { font-size: 30px !important; }
    #fcc-prep-{{ section.id }} .fcc-prep__description { font-size: 16px !important; }
    #fcc-prep-{{ section.id }} .fcc-prep__grid {
      gap: 16px;
      margin-right: -24px;
      padding-right: 24px;
    }
    #fcc-prep-{{ section.id }} .fcc-prep__card {
      flex: 0 0 calc(85vw - 24px);
      max-width: 340px;
      padding: 24px;
    }
    #fcc-prep-{{ section.id }} .fcc-prep__card-title { font-size: 19px !important; }
  }
</style>
<section aria-labelledby="fcc-prep-heading-{{ section.id }}" class="fcc-prep" id="fcc-prep-{{ section.id }}"><div aria-hidden="true" class="fcc-prep__section-bg">
{%- if section.settings.bg_image != blank -%}
  {{ section.settings.bg_image | image_url: width: 2400 | image_tag: 
     loading: 'lazy',
     sizes: '100vw',
     widths: '1000, 1600, 2400',
     style: 'object-position:50.0% 51.66%; width: 100%; height: 100%; object-fit: cover;'
  }}
{%- else -%}
  <img alt="" height="1569" loading="lazy" src="//formuland.com/cdn/shop/files/Section_2.jpg?v=1786631554&amp;width=2400" srcset="//formuland.com/cdn/shop/files/Section_2.jpg?v=1786631554&amp;width=1000 1000w, //formuland.com/cdn/shop/files/Section_2.jpg?v=1786631554&amp;width=1600 1600w, //formuland.com/cdn/shop/files/Section_2.jpg?v=1786631554&amp;width=2400 2400w" style="object-position:50.0% 51.66%;" width="2400"/>
{%- endif -%}
</div><div class="fcc-prep__wrap">
<div class="fcc-prep__header-row">
<div class="fcc-prep__header-text"><p class="fcc-prep__subheading">{{ section.settings.subheading }}</p><h2 class="fcc-prep__heading" id="fcc-prep-heading-{{ section.id }}">{{ section.settings.heading_for_hipp }}</h2>
<div class="fcc-prep__description">{{ section.settings.description }}</div>
</div>
<div class="fcc-prep__controls">
<button aria-label="Previous steps" class="fcc-prep__arrow fcc-prep__arrow--prev" id="fcc-prep-prev-{{ section.id }}" type="button">
<svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewbox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg>
</button>
<button aria-label="Next steps" class="fcc-prep__arrow fcc-prep__arrow--next" id="fcc-prep-next-{{ section.id }}" type="button">
<svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewbox="0 0 24 24"><path d="M9 18l6-6-6-6"></path></svg>
</button>
</div>
</div>
<div class="fcc-prep__grid" id="fcc-prep-slider-{{ section.id }}">
{%- for tip in prep_tips -%}
<div class="fcc-prep__card">
<div class="fcc-prep__card-num">{{ forloop.index }}.</div>
<h3 class="fcc-prep__card-title">{{ tip.title.value }}</h3>
<div class="fcc-prep__card-desc">{{ tip.description | metafield_tag }}</div>
</div>
{%- endfor -%}
</div><a class="fcc-prep__btn" href="#curated-range" id="fcc-prep-btn-{{ section.id }}">
        {{ section.settings.cta_text }}
      </a></div>
</section>
<script>
  (function () {
    var slider = document.getElementById('fcc-prep-slider-{{ section.id }}');
    var btnPrev = document.getElementById('fcc-prep-prev-{{ section.id }}');
    var btnNext = document.getElementById('fcc-prep-next-{{ section.id }}');
    var cta = document.getElementById('fcc-prep-btn-{{ section.id }}');

    if (slider && btnPrev && btnNext) {
      var scrollAmount = function () {
        var card = slider.querySelector('.fcc-prep__card');
        if (card) {
          var gap = window.innerWidth > 1024 ? 24 : 16;
          return card.offsetWidth + gap;
        }
        return 300;
      };
      var update = function () {
        var maxScroll = slider.scrollWidth - slider.clientWidth;
        btnPrev.disabled = slider.scrollLeft <= 1;
        btnNext.disabled = slider.scrollLeft >= maxScroll - 1;
      };
      btnPrev.addEventListener('click', function () {
        slider.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
      btnNext.addEventListener('click', function () {
        slider.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
      slider.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    if (cta) {
      cta.addEventListener('click', function (e) {
        var href = cta.getAttribute('href') || '';
        if (href.charAt(0) !== '#') return;
        e.preventDefault();
        var target = document.getElementById(href.slice(1));
        if (target) {
          var top = target.getBoundingClientRect().top + window.pageYOffset - 100;
          window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
        } else {
          // No matching anchor on the page: the product grid sits at the
          // top of the collection template, so scroll there.
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }
  })();
</script>
</section>
{% endif %}
{% schema %}
{
  "name": "Collection Prep Tips",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "PREPARATION AND STORAGE TIPS"
    },
    {
      "type": "inline_richtext",
      "id": "heading_for_hipp",
      "label": "Heading",
      "default": "For <em>HiPP Organic Formula</em>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Follow these general guidelines when preparing HiPP Organic formula. Always check the instructions printed on the tin for stage-specific measurements and any brand variations.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "SHOP OUR HIPP ORGANIC FORMULA"
    }
  ],
  "presets": [
    {
      "name": "Formula Collection Prep Tips"
    }
  ]
}
{% endschema %}
