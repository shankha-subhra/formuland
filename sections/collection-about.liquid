<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&amp;family=Libre+Franklin:wght@400;500;600&amp;family=Tenor+Sans&amp;display=swap">

<style data-shopify="">
  #fcc-faq-{{ section.id }} {
    position: relative;
    background-color: #f4f7ee;
    padding: 100px 24px 100px;
    overflow: hidden;
  }

  /* Section background image */
  #fcc-faq-{{ section.id }} .fcc-faq__section-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__section-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1.0;
  }

  #fcc-faq-{{ section.id }} .fcc-faq__wrap {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header */
  #fcc-faq-{{ section.id }} .fcc-faq__header {
    text-align: center;
    margin-bottom: 56px;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__subheading {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #13322b;
    margin: 0 0 16px;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__heading {
    font-family: 'Libre Baskerville', serif !important;
    font-weight: 400 !important;
    font-size: 40px !important;
    line-height: 1.3 !important;
    color: #13322b;
    margin: 0;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__heading em {
    font-style: italic;
    color: inherit;
  }

  /* Accordion */
  #fcc-faq-{{ section.id }} .fcc-faq__item {
    border-bottom: 1px solid #d3dbce;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__item:first-child {
    border-top: 1px solid #d3dbce;
  }

  #fcc-faq-{{ section.id }} .fcc-faq__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    font-family: 'Tenor Sans', sans-serif !important;
    font-size: 22px !important;
    font-weight: 400 !important;
    line-height: 1.4 !important;
    color: #13322b;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__item summary::-webkit-details-marker { display: none; }

  #fcc-faq-{{ section.id }} .fcc-faq__chev {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    color: #13322b;
    transition: transform 0.3s ease;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__item[open] .fcc-faq__chev { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) {
    #fcc-faq-{{ section.id }} .fcc-faq__chev { transition: none; }
  }

  #fcc-faq-{{ section.id }} .fcc-faq__answer {
    padding: 0 0 24px 0;
    max-width: 980px;
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 16px !important;
    line-height: 1.7 !important;
    color: #13322b;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__answer p {
    margin: 0 0 16px;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__answer p:last-child { margin-bottom: 0; }
  #fcc-faq-{{ section.id }} .fcc-faq__answer ul,
  #fcc-faq-{{ section.id }} .fcc-faq__answer ol {
    margin: 0 0 16px 20px;
    padding: 0;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__answer li { margin-bottom: 8px; }
  #fcc-faq-{{ section.id }} .fcc-faq__answer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Tablet & mobile */
  @media (max-width: 1024px) {
    #fcc-faq-{{ section.id }} .fcc-faq__header { margin-bottom: 40px; }
    #fcc-faq-{{ section.id }} .fcc-faq__heading { font-size: 30px !important; }
    #fcc-faq-{{ section.id }} .fcc-faq__item summary {
      padding: 20px 0;
      font-size: 19px !important;
    }
    #fcc-faq-{{ section.id }} .fcc-faq__answer { font-size: 15px !important; }
  }
</style>

<section id="fcc-faq-{{ section.id }}" class="fcc-faq" aria-labelledby="fcc-faq-heading-{{ section.id }}"><div class="fcc-faq__section-bg" aria-hidden="true">
{%- if section.settings.bg_image != blank -%}
  {{ section.settings.bg_image | image_url: width: 2400 | image_tag: 
     loading: 'lazy',
     sizes: '100vw',
     widths: '1000, 1600, 2400',
     style: 'object-position:53.418% 92.09%; width: 100%; height: 100%; object-fit: cover;'
  }}
{%- else -%}
  <img src="//formuland.com/cdn/shop/files/Section_1.jpg?v=1786629242&amp;width=2400" alt="" srcset="//formuland.com/cdn/shop/files/Section_1.jpg?v=1786629242&amp;width=1000 1000w, //formuland.com/cdn/shop/files/Section_1.jpg?v=1786629242&amp;width=1600 1600w, //formuland.com/cdn/shop/files/Section_1.jpg?v=1786629242&amp;width=2400 2400w" width="2400" height="1569" loading="lazy" style="object-position:53.418% 92.09%;">
{%- endif -%}
</div><div class="fcc-faq__wrap">

<div class="fcc-faq__header"><p class="fcc-faq__subheading">{{ section.settings.subheading }}</p><h2 class="fcc-faq__heading" id="fcc-faq-heading-{{ section.id }}">{{ section.settings.heading }}</h2></div>

<div class="fcc-faq__list" id="fcc-faq-list-{{ section.id }}">
{%- for block in section.blocks -%}
  <details class="fcc-faq__item" {{ block.shopify_attributes }}>
    <summary>
      <span>{{ block.settings.question }}</span>
      <svg class="fcc-faq__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
    </summary>
    <div class="fcc-faq__answer">
      {{ block.settings.answer }}
    </div>
  </details>
{%- endfor -%}
</div>

</div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
<script>
  (function () {
    var list = document.getElementById('fcc-faq-list-{{ section.id }}');
    if (!list) return;
    var items = list.querySelectorAll('.fcc-faq__item');

    // Enforce one-open on load: keep only the first open item open
    var foundOpen = false;
    items.forEach(function (item) {
      if (item.open) {
        if (foundOpen) { item.open = false; }
        foundOpen = true;
      }
    });

    items.forEach(function (item) {
      item.addEventListener('toggle', function () {
        if (!item.open) return;
        items.forEach(function (other) {
          if (other !== item && other.open) other.open = false;
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection FAQ",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About HiPP Organic Formula" 
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question text here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer text goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Formula Collection FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Where is the best place to buy HiPP formula?",
            "answer": "<p>HiPP formula is not commonly stocked in U.S. retail stores. Formuland is one of the most established sources for authentic HiPP Organic formula in the United States, with direct supplier relationships and U.S.-based warehousing. You can shop our curated formulas and receive your order within one to three business days on standard shipping.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you have to boil water for HiPP Organic formula?",
            "answer": "<p>Yes. Using freshly boiled water is recommended for hygiene and safety. However, make sure to allow the water to cool to the temperature specified on the tin before adding the formula powder, as excessive heat can affect the live cultures in HiPP's Combiotic® blend.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What makes HiPP Organic formula a good choice for your baby?",
            "answer": "<p>HiPP Organic formula is free of corn syrup, GMOs, and artificial additives. It’s certified organic by the European Union and formulated with key nutrients including DHA, ALA, and the Combiotic® blend of prebiotics and probiotics. The brand also conducts up to 260 safety checks per product, providing a high level of quality assurance that is difficult to match.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
