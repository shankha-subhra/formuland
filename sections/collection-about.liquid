{% assign faqs = collection.metafields.custom.faqs.value %}
{% if faqs != blank %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&amp;family=Libre+Franklin:wght@400;500;600&amp;family=Tenor+Sans&amp;display=swap">

<style data-shopify="">
  #fcc-faq-{{ section.id }} {
    position: relative;
    background-color: #f4f7ee;
    padding: 100px 24px 100px;
    overflow: hidden;
  }

  /* Section background image */
  #fcc-faq-{{ section.id }} .fcc-faq__section-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__section-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1.0;
  }

  #fcc-faq-{{ section.id }} .fcc-faq__wrap {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header */
  #fcc-faq-{{ section.id }} .fcc-faq__header {
    text-align: center;
    margin-bottom: 56px;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__subheading {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #13322b;
    margin: 0 0 16px;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__heading {
    font-family: 'Libre Baskerville', serif !important;
    font-weight: 400 !important;
    font-size: 40px !important;
    line-height: 1.3 !important;
    color: #13322b;
    margin: 0;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__heading em {
    font-style: italic;
    color: inherit;
  }

  /* Accordion */
  #fcc-faq-{{ section.id }} .fcc-faq__item {
    border-bottom: 1px solid #d3dbce;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__item:first-child {
    border-top: 1px solid #d3dbce;
  }

  #fcc-faq-{{ section.id }} .fcc-faq__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    font-family: 'Tenor Sans', sans-serif !important;
    font-size: 22px !important;
    font-weight: 400 !important;
    line-height: 1.4 !important;
    color: #13322b;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__item summary::-webkit-details-marker { display: none; }

  #fcc-faq-{{ section.id }} .fcc-faq__chev {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    color: #13322b;
    transition: transform 0.3s ease;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__item[open] .fcc-faq__chev { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) {
    #fcc-faq-{{ section.id }} .fcc-faq__chev { transition: none; }
  }

  #fcc-faq-{{ section.id }} .fcc-faq__answer {
    padding: 0 0 24px 0;
    max-width: 980px;
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 16px !important;
    line-height: 1.7 !important;
    color: #13322b;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__answer p {
    margin: 0 0 16px;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__answer p:last-child { margin-bottom: 0; }
  #fcc-faq-{{ section.id }} .fcc-faq__answer ul,
  #fcc-faq-{{ section.id }} .fcc-faq__answer ol {
    margin: 0 0 16px 20px;
    padding: 0;
  }
  #fcc-faq-{{ section.id }} .fcc-faq__answer li { margin-bottom: 8px; }
  #fcc-faq-{{ section.id }} .fcc-faq__answer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Tablet & mobile */
  @media (max-width: 1024px) {
    #fcc-faq-{{ section.id }} .fcc-faq__header { margin-bottom: 40px; }
    #fcc-faq-{{ section.id }} .fcc-faq__heading { font-size: 30px !important; }
    #fcc-faq-{{ section.id }} .fcc-faq__item summary {
      padding: 20px 0;
      font-size: 19px !important;
    }
    #fcc-faq-{{ section.id }} .fcc-faq__answer { font-size: 15px !important; }
  }
</style>

<section id="fcc-faq-{{ section.id }}" class="fcc-faq" aria-labelledby="fcc-faq-heading-{{ section.id }}"><div class="fcc-faq__section-bg" aria-hidden="true">
{%- if section.settings.bg_image != blank -%}
  {{ section.settings.bg_image | image_url: width: 2400 | image_tag: 
     loading: 'lazy',
     sizes: '100vw',
     widths: '1000, 1600, 2400',
     style: 'object-position:53.418% 92.09%; width: 100%; height: 100%; object-fit: cover;'
  }}
{%- else -%}
  <img src="//formuland.com/cdn/shop/files/Section_1.jpg?v=1786629242&amp;width=2400" alt="" srcset="//formuland.com/cdn/shop/files/Section_1.jpg?v=1786629242&amp;width=1000 1000w, //formuland.com/cdn/shop/files/Section_1.jpg?v=1786629242&amp;width=1600 1600w, //formuland.com/cdn/shop/files/Section_1.jpg?v=1786629242&amp;width=2400 2400w" width="2400" height="1569" loading="lazy" style="object-position:53.418% 92.09%;">
{%- endif -%}
</div><div class="fcc-faq__wrap">

<div class="fcc-faq__header"><p class="fcc-faq__subheading">{{ section.settings.subheading }}</p><h2 class="fcc-faq__heading" id="fcc-faq-heading-{{ section.id }}">{{ section.settings.heading }}</h2></div>

<div class="fcc-faq__list" id="fcc-faq-list-{{ section.id }}">
{%- for faq in faqs -%}
  <details class="fcc-faq__item">
    <summary>
      <span>{{ faq.question.value }}</span>
      <svg class="fcc-faq__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
    </summary>
    <div class="fcc-faq__answer">
      {{ faq.answer | metafield_tag }}
    </div>
  </details>
{%- endfor -%}
</div>

</div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for faq in faqs -%}
      {
        "@type": "Question",
        "name": {{ faq.question.value | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ faq.answer | metafield_tag | strip_html | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
<script>
  (function () {
    var list = document.getElementById('fcc-faq-list-{{ section.id }}');
    if (!list) return;
    var items = list.querySelectorAll('.fcc-faq__item');

    // Enforce one-open on load: keep only the first open item open
    var foundOpen = false;
    items.forEach(function (item) {
      if (item.open) {
        if (foundOpen) { item.open = false; }
        foundOpen = true;
      }
    });

    items.forEach(function (item) {
      item.addEventListener('toggle', function () {
        if (!item.open) return;
        items.forEach(function (other) {
          if (other !== item && other.open) other.open = false;
        });
      });
    });
  })();
</script>
{% endif %}
{% schema %}
{
  "name": "Collection FAQ",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About HiPP Organic Formula" 
    }
  ],
  "presets": [
    {
      "name": "Formula Collection FAQ"
    }
  ]
}
{% endschema %}
