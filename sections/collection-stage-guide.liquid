{% assign stages = collection.metafields.custom.formula_stages.value %}
{% if stages != blank %}
<section class="shopify-section fcc-sg-section" id="shopify-section-{{ section.id }}">
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&amp;family=Libre+Franklin:wght@400;500;600&amp;family=Tenor+Sans&amp;display=swap" rel="stylesheet"/>
<style data-shopify="">
  #fcc-sg-{{ section.id }} {
    background-color: #fbfbf8;
    padding: 100px 24px 100px;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 80px;
    align-items: start;
  }

  /* Left column */
  #fcc-sg-{{ section.id }} .fcc-sg__subheading {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #13322b;
    margin: 0 0 16px;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__heading {
    font-family: 'Libre Baskerville', serif !important;
    font-weight: 400 !important;
    font-size: 40px !important;
    line-height: 1.3 !important;
    color: #13322b;
    margin: 0 0 24px;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__heading em {
    font-style: italic;
    color: inherit;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__desc {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: clamp(16px, 1.4vw, 18px) !important;
    line-height: 1.6 !important;
    color: #13322b;
    margin: 0;
  }

  /* Right column: table */
  #fcc-sg-{{ section.id }} .fcc-sg__table-wrapper { width: 100%; }
  #fcc-sg-{{ section.id }} .fcc-sg__table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__table th,
  #fcc-sg-{{ section.id }} .fcc-sg__table td {
    border: 1px solid #d3dbce;
    padding: 24px 20px;
    vertical-align: middle;
    background: transparent;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__table th {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    line-height: 1.4 !important;
    color: #13322b;
    text-align: center;
    padding: 16px 20px;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__table td:first-child {
    text-align: center;
    width: 32%;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__table td:last-child { text-align: left; }

  #fcc-sg-{{ section.id }} .fcc-sg__stage-title {
    display: block;
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 16px !important;
    line-height: 1.5 !important;
    color: #13322b;
    margin: 0;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__stage-age {
    display: block;
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 16px !important;
    line-height: 1.5 !important;
    color: #13322b;
  }
  #fcc-sg-{{ section.id }} .fcc-sg__key-notes {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 16px !important;
    line-height: 1.6 !important;
    color: #13322b;
    margin: 0;
  }

  /* Footer note */
  #fcc-sg-{{ section.id }} .fcc-sg__footer {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 16px !important;
    line-height: 1.65 !important;
    color: #13322b;
    margin: 0;
  }

  /* Tablet & mobile */
  @media (max-width: 1024px) {
    #fcc-sg-{{ section.id }} .fcc-sg__wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    #fcc-sg-{{ section.id }} .fcc-sg__heading { font-size: 30px !important; }
    #fcc-sg-{{ section.id }} .fcc-sg__desc { font-size: 16px !important; }
    #fcc-sg-{{ section.id }} .fcc-sg__table th,
    #fcc-sg-{{ section.id }} .fcc-sg__table td { padding: 16px 12px; }
    #fcc-sg-{{ section.id }} .fcc-sg__table td:first-child { width: 40%; }
    #fcc-sg-{{ section.id }} .fcc-sg__stage-title,
    #fcc-sg-{{ section.id }} .fcc-sg__stage-age,
    #fcc-sg-{{ section.id }} .fcc-sg__key-notes { font-size: 15px !important; }
  }
</style>
<section aria-labelledby="fcc-sg-heading-{{ section.id }}" class="fcc-sg" id="fcc-sg-{{ section.id }}">
<div class="fcc-sg__wrap">
<div class="fcc-sg__left"><p class="fcc-sg__subheading">{{ section.settings.subheading }}</p><h2 class="fcc-sg__heading" id="fcc-sg-heading-{{ section.id }}">{{ section.settings.heading_right_stage }}</h2>
<div class="fcc-sg__desc">{{ section.settings.description }}</div>
</div>
<div class="fcc-sg__right">
<div class="fcc-sg__table-wrapper">
<table class="fcc-sg__table">
<thead>
<tr>
<th scope="col">Stage</th>
<th scope="col">Key Notes</th>
</tr>
</thead>
<tbody>
{%- for stage in stages -%}
<tr>
<td>
<span class="fcc-sg__stage-title">{{ stage.stage_title.value }}</span><span class="fcc-sg__stage-age">{{ stage.age.value }}</span></td>
<td>
<div class="fcc-sg__key-notes">{{ stage.notes | metafield_tag }}</div>
</td>
</tr>
{%- endfor -%}
</tbody>
</table>
</div><div class="fcc-sg__footer">{{ section.settings.footer_note }}</div></div>
</div>
</section>
</section>
{% endif %}
{% schema %}
{
  "name": "Collection Stage Guide",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "HOW TO CHOOSE"
    },
    {
      "type": "inline_richtext",
      "id": "heading_right_stage",
      "label": "Heading",
      "default": "The Right Organic Baby Formula Stage or Specialty Formula For My Baby"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>HiPP stages correspond to your baby’s age and developmental needs. Here’s a simple guide to help you choose:</p>"
    },
    {
      "type": "richtext",
      "id": "footer_note",
      "label": "Footer Note",
      "default": "<p>If your baby is doing well on their current formula, there’s generally no need to change stages early, unless advised otherwise by your pediatrician or healthcare provider. When in doubt, your pediatrician can help guide the transition.</p>"
    }
  ],
  "presets": [
    {
      "name": "Formula Collection Stage Guide"
    }
  ]
}
{% endschema %}
