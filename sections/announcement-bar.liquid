<style>
  #announcement-slider-{{ section.id }} {
    position: relative;
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    z-index: 999;
    cursor: pointer;
  }

  #announcement-slider-{{ section.id }} .fas-track {
    position: relative;
    min-height: {{ section.settings.height }}px;
  }

  #announcement-slider-{{ section.id }} .fas-slide {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 8px 20px;

    text-align: center;

    opacity: 0;
    visibility: hidden;

    transform: translateY(8px);

    transition:
      opacity 0.35s ease,
      transform 0.35s ease,
      visibility 0.35s ease;
  }

  #announcement-slider-{{ section.id }} .fas-slide.is-active {
    position: relative;

    opacity: 1;
    visibility: visible;

    transform: translateY(0);
  }

  #announcement-slider-{{ section.id }} .fas-message {
    margin: 0;

    font-family: inherit;

    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    line-height: 1.4;

    color: inherit;
  }

  #announcement-slider-{{ section.id }} .fas-icon {
    margin-right: 4px;
  }

  #announcement-slider-{{ section.id }} .fas-link {
    display: inline-block;

    margin-left: 5px;

    color: inherit;

    font-weight: 600;

    text-decoration: underline;
    text-underline-offset: 2px;

    cursor: pointer;
  }

  #announcement-slider-{{ section.id }} .fas-link:hover {
    opacity: 0.75;
  }

  @media (max-width: 767px) {

    #announcement-slider-{{ section.id }} .fas-track {
      min-height: {{ section.settings.mobile_height }}px;
    }

    #announcement-slider-{{ section.id }} .fas-slide {
      padding: 7px 15px;
    }

    #announcement-slider-{{ section.id }} .fas-message {
      font-size: {{ section.settings.mobile_font_size }}px;
    }

  }

  @media (prefers-reduced-motion: reduce) {

    #announcement-slider-{{ section.id }} .fas-slide {
      transition: none;
    }

  }
</style>


<div
  id="announcement-slider-{{ section.id }}"
  class="formuland-announcement-slider"
  data-announcement-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>

  <div class="fas-track">

    {% for block in section.blocks %}

      <div
        class="fas-slide{% if forloop.first %} is-active{% endif %}"
        data-announcement-slide
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >

        <p class="fas-message">

          {% if block.settings.icon != blank %}
            <span class="fas-icon">
              {{ block.settings.icon }}
            </span>
          {% endif %}

          <span class="fas-text">
            {{ block.settings.text }}
          </span>

          {% if block.settings.link_text != blank and block.settings.link != blank %}

            <a
              href="{{ block.settings.link }}"
              class="fas-link"
            >
              {{ block.settings.link_text }}
            </a>

          {% endif %}

        </p>

      </div>

    {% endfor %}

  </div>

</div>


<script>
(function () {

  var slider = document.getElementById(
    'announcement-slider-{{ section.id }}'
  );

  if (!slider) return;

  var slides = slider.querySelectorAll(
    '[data-announcement-slide]'
  );

  if (!slides.length) return;


  var current = 0;

  var autoplay =
    slider.getAttribute('data-autoplay') === 'true';

  var speed =
    parseInt(
      slider.getAttribute('data-speed'),
      10
    ) || 4000;

  var timer = null;


  function showSlide(index) {

    if (index >= slides.length) {
      index = 0;
    }

    if (index < 0) {
      index = slides.length - 1;
    }


    slides.forEach(function (slide) {
      slide.classList.remove('is-active');
    });


    slides[index].classList.add(
      'is-active'
    );


    current = index;

  }


  function nextSlide() {

    showSlide(
      current + 1
    );

  }


  function stopAutoplay() {

    if (timer) {

      clearInterval(timer);

      timer = null;

    }

  }


  function startAutoplay() {

    stopAutoplay();


    if (
      !autoplay ||
      slides.length <= 1
    ) {
      return;
    }


    timer = setInterval(
      function () {

        nextSlide();

      },
      speed
    );

  }


  /*
   * Click anywhere on announcement bar
   * to show the next announcement.
   *
   * If user clicks Shop Now or another link,
   * allow the link to open normally.
   */
  slider.addEventListener(
    'click',
    function (event) {

      if (
        event.target.closest('a')
      ) {
        return;
      }


      nextSlide();


      /*
       * Reset autoplay timer
       * after manual slide change.
       */
      startAutoplay();

    }
  );


  /*
   * Pause autoplay on hover
   */
  slider.addEventListener(
    'mouseenter',
    function () {

      stopAutoplay();

    }
  );


  /*
   * Restart autoplay
   */
  slider.addEventListener(
    'mouseleave',
    function () {

      startAutoplay();

    }
  );


  /*
   * Pause when browser tab is hidden.
   */
  document.addEventListener(
    'visibilitychange',
    function () {

      if (document.hidden) {

        stopAutoplay();

      } else {

        startAutoplay();

      }

    }
  );


  /*
   * Initialize slider
   */
  showSlide(0);

  startAutoplay();

})();
</script>


{% schema %}
{
  "name": "Announcement Slider",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#13322B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 30,
      "max": 80,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 30,
      "max": 100,
      "step": 2,
      "default": 46,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slide every",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "s"
    }
  ],

  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / emoji",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Announcement",
          "default": "Fast and Free Shipping on 4/6/8/12 Packs."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],

  "max_blocks": 10,

  "presets": [
    {
      "name": "Announcement Slider",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "⚡",
            "text": "Fast and Free Shipping on 4/6/8/12 Packs.",
            "link_text": "Shop Now"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "🏆",
            "text": "Shop our Best Selling European Baby Formulas.",
            "link_text": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}