<style>
  #custom-announcement-{{ section.id }} {
    position: relative;
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    z-index: 100;
  }

  #custom-announcement-{{ section.id }} *,
  #custom-announcement-{{ section.id }} *::before,
  #custom-announcement-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__holder {
    position: relative;
    width: 100%;
    height: {{ section.settings.height }}px;
    overflow: hidden;

    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__slide {
    position: absolute;
    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0 55px;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateX(30px);

    transition:
      opacity 0.35s ease,
      transform 0.35s ease,
      visibility 0.35s ease;

    z-index: 1;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__slide.is-selected {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateX(0);

    z-index: 2;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__message {
    width: 100%;
    text-align: center;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__text {
    width: 100%;
    text-align: center;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__text p {
    margin: 0;

    color: {{ section.settings.text_color }};

    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    line-height: 1.4;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__icon {
    display: inline-block;
    margin-right: 3px;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__link {
    margin-left: 3px;

    color: {{ section.settings.text_color }};
    font-weight: 600;

    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* =====================================
     PREVIOUS / NEXT
     ===================================== */

  #custom-announcement-{{ section.id }} .custom-announcement__arrow {
    position: absolute;
    top: 50%;

    transform: translateY(-50%);

    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 0;
    background: transparent;

    color: {{ section.settings.text_color }};

    cursor: pointer;

    z-index: 20;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__arrow--prev {
    left: 10px;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__arrow--next {
    right: 10px;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__arrow svg {
    display: block;
    width: 10px;
    height: 18px;
  }

  #custom-announcement-{{ section.id }} .custom-announcement__arrow:hover {
    opacity: 0.65;
  }

  /* =====================================
     MOBILE
     ===================================== */

  @media screen and (max-width: 767px) {
    #custom-announcement-{{ section.id }} .custom-announcement__holder {
      height: {{ section.settings.mobile_height }}px;
    }

    #custom-announcement-{{ section.id }} .custom-announcement__slide {
      padding-left: 42px;
      padding-right: 42px;
    }

    #custom-announcement-{{ section.id }} .custom-announcement__text p {
      font-size: {{ section.settings.mobile_font_size }}px;
      line-height: 1.35;
    }

    #custom-announcement-{{ section.id }} .custom-announcement__arrow {
      width: 32px;
      height: 32px;
    }

    #custom-announcement-{{ section.id }} .custom-announcement__arrow--prev {
      left: 3px;
    }

    #custom-announcement-{{ section.id }} .custom-announcement__arrow--next {
      right: 3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #custom-announcement-{{ section.id }} .custom-announcement__slide {
      transition: none;
    }
  }
</style>


<div
  id="custom-announcement-{{ section.id }}"
  class="custom-announcement"
>

  <div
    class="custom-announcement__holder"
    data-custom-announcement-slider
  >

    {% for block in section.blocks %}
      <div
        class="custom-announcement__slide{% if forloop.first %} is-selected{% endif %}"
        data-custom-announcement-slide
        data-custom-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >

        <div class="custom-announcement__message">

          <div class="custom-announcement__text">

            {% if block.settings.text != blank %}
              <p>

                {% if block.settings.icon != blank %}
                  <span class="custom-announcement__icon">
                    {{ block.settings.icon }}
                  </span>
                {% endif %}

                <span>
                  {{ block.settings.text }}
                </span>

                {% if block.settings.link_text != blank and block.settings.link != blank %}
                  <a
                    href="{{ block.settings.link }}"
                    class="custom-announcement__link"
                  >
                    {{ block.settings.link_text }}
                  </a>
                {% endif %}

              </p>
            {% endif %}

          </div>

        </div>

      </div>
    {% endfor %}


    {% if section.blocks.size > 1 %}

      <button
        type="button"
        class="custom-announcement__arrow custom-announcement__arrow--prev"
        data-custom-announcement-prev
        aria-label="Previous announcement"
      >
        <svg
          viewBox="0 0 12 20"
          aria-hidden="true"
        >
          <path
            d="M10 2L2 10L10 18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>


      <button
        type="button"
        class="custom-announcement__arrow custom-announcement__arrow--next"
        data-custom-announcement-next
        aria-label="Next announcement"
      >
        <svg
          viewBox="0 0 12 20"
          aria-hidden="true"
        >
          <path
            d="M2 2L10 10L2 18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>

    {% endif %}

  </div>

</div>


<script>
(function () {

  var section = document.getElementById(
    'custom-announcement-{{ section.id }}'
  );

  if (!section) return;


  var slider = section.querySelector(
    '[data-custom-announcement-slider]'
  );

  if (!slider) return;


  var slides = Array.prototype.slice.call(
    slider.querySelectorAll(
      '[data-custom-announcement-slide]'
    )
  );

  if (!slides.length) return;


  var previousButton = slider.querySelector(
    '[data-custom-announcement-prev]'
  );

  var nextButton = slider.querySelector(
    '[data-custom-announcement-next]'
  );


  var currentIndex = 0;


  /* =====================================
     SHOW SLIDE
     ===================================== */

  function showSlide(index) {

    if (index >= slides.length) {
      index = 0;
    }

    if (index < 0) {
      index = slides.length - 1;
    }


    slides.forEach(function (slide, slideIndex) {

      slide.classList.toggle(
        'is-selected',
        slideIndex === index
      );

    });


    currentIndex = index;

  }


  /* =====================================
     NEXT
     ===================================== */

  function nextSlide() {

    showSlide(
      currentIndex + 1
    );

  }


  /* =====================================
     PREVIOUS
     ===================================== */

  function previousSlide() {

    showSlide(
      currentIndex - 1
    );

  }


  /* =====================================
     NEXT CLICK
     ===================================== */

  if (nextButton) {

    nextButton.addEventListener(
      'click',
      function (event) {

        event.preventDefault();
        event.stopPropagation();

        nextSlide();

      }
    );

  }


  /* =====================================
     PREVIOUS CLICK
     ===================================== */

  if (previousButton) {

    previousButton.addEventListener(
      'click',
      function (event) {

        event.preventDefault();
        event.stopPropagation();

        previousSlide();

      }
    );

  }


  /* =====================================
     MOBILE TOUCH / SWIPE
     ===================================== */

  var touchStartX = 0;
  var touchStartY = 0;

  var touchCurrentX = 0;
  var touchCurrentY = 0;

  var isTouching = false;

  var SWIPE_THRESHOLD = 40;


  slider.addEventListener(
    'touchstart',
    function (event) {

      if (!event.touches.length) return;

      touchStartX =
        event.touches[0].clientX;

      touchStartY =
        event.touches[0].clientY;

      touchCurrentX =
        touchStartX;

      touchCurrentY =
        touchStartY;

      isTouching = true;

    },
    {
      passive: true
    }
  );


  slider.addEventListener(
    'touchmove',
    function (event) {

      if (!isTouching) return;

      if (!event.touches.length) return;


      touchCurrentX =
        event.touches[0].clientX;

      touchCurrentY =
        event.touches[0].clientY;

    },
    {
      passive: true
    }
  );


  slider.addEventListener(
    'touchend',
    function () {

      if (!isTouching) return;

      isTouching = false;


      var differenceX =
        touchCurrentX - touchStartX;

      var differenceY =
        touchCurrentY - touchStartY;


      /*
       * Vertical movement is stronger,
       * so allow normal page scrolling.
       */
      if (
        Math.abs(differenceY) >
        Math.abs(differenceX)
      ) {
        return;
      }


      /*
       * Ignore tiny finger movement.
       */
      if (
        Math.abs(differenceX) <
        SWIPE_THRESHOLD
      ) {
        return;
      }


      /*
       * Swipe LEFT
       * = NEXT
       */
      if (differenceX < 0) {

        nextSlide();

      }

      /*
       * Swipe RIGHT
       * = PREVIOUS
       */
      else {

        previousSlide();

      }

    },
    {
      passive: true
    }
  );


  slider.addEventListener(
    'touchcancel',
    function () {

      isTouching = false;

    },
    {
      passive: true
    }
  );


  /* =====================================
     SHOPIFY THEME EDITOR
     ===================================== */

  document.addEventListener(
    'shopify:block:select',
    function (event) {

      var selectedSlide =
        event.target.closest(
          '[data-custom-announcement-slide]'
        );

      if (!selectedSlide) return;

      if (!section.contains(selectedSlide)) {
        return;
      }


      var index =
        slides.indexOf(selectedSlide);


      if (index === -1) return;


      showSlide(index);

    }
  );


  /* =====================================
     INITIALIZE
     ===================================== */

  showSlide(0);

})();
</script>


{% schema %}
{
  "name": "Custom Announcement",
  "tag": "section",
  "class": "custom-announcement-section",

  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#E6F28D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#13322B"
    },

    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 30,
      "max": 70,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 13,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Height",
      "min": 36,
      "max": 90,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    }
  ],

  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / emoji",
          "default": "⚡"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Announcement text",
          "default": "Fast and Free Shipping on 4/6/8/12 Packs."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],

  "max_blocks": 10,

  "presets": [
    {
      "name": "Custom Announcement",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "⚡",
            "text": "Fast and Free Shipping on 4/6/8/12 Packs.",
            "link_text": "Shop Now"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "🏆",
            "text": "Shop our Best Selling European Baby Formulas.",
            "link_text": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}