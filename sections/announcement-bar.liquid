<div
  id="shopify-section-announcement"
  class="shopify-section"
>
  <div
    class="announcement__wrapper"
    data-announcement-wrapper
    data-section-id="announcement"
    data-section-type="announcement"
  >

    <div class="announcement__font font--4">

      <div
        class="announcement__bar-outer"
        data-bar
        style="
          --bg: var(--COLOR-ANNOUNCEMENT-BG);
          --text: var(--COLOR-ANNOUNCEMENT-TEXT);
        "
      >

        <div
          class="announcement__bar-holder"
          data-announcement-slider
          data-slider-speed="8000"
        >

          <!-- Slide 1 -->
          <div
            class="announcement__bar is-selected"
            data-slide
            data-slide-index="0"
          >
            <div
              data-ticker-frame
              class="announcement__message"
            >
              <div
                data-ticker-scale
                class="announcement__scale"
              >
                <div
                  data-ticker-text
                  class="announcement__text"
                >
                  <p>
                    ⚡ Fast and Free Shipping on 4/6/8/12
                    <br>
                    Packs.

                    <a href="/collections/goat-milk-formula">
                      <strong>Shop Now</strong>
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>


          <!-- Slide 2 -->
          <div
            class="announcement__bar"
            data-slide
            data-slide-index="1"
          >
            <div
              data-ticker-frame
              class="announcement__message"
            >
              <div
                data-ticker-scale
                class="announcement__scale"
              >
                <div
                  data-ticker-text
                  class="announcement__text"
                >
                  <p>
                    🏆 Shop our Best Selling European Baby
                    <br>
                    Formulas.

                    <a href="/collections">
                      <strong>Shop Now</strong>
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</div>


<style>
  #shopify-section-announcement {
    position: relative;
    z-index: 200;
  }

  #shopify-section-announcement * {
    box-sizing: border-box;
  }

  #shopify-section-announcement
  .announcement__bar-outer {
    width: 100%;
    background-color: #e6f28d;
    color: #13322b;
    overflow: hidden;
  }

  #shopify-section-announcement
  .announcement__bar-holder {
    position: relative;
    width: 100%;
    height: 36px;
    overflow: hidden;
    cursor: pointer;
  }

  #shopify-section-announcement
  .announcement__bar {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    opacity: 0;
    visibility: hidden;

    transform: translateX(30px);

    transition:
      opacity 0.35s ease,
      transform 0.35s ease,
      visibility 0.35s ease;
  }

  #shopify-section-announcement
  .announcement__bar.is-selected {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    z-index: 2;
  }

  #shopify-section-announcement
  .announcement__message {
    width: 100%;
    text-align: center;
  }

  #shopify-section-announcement
  .announcement__text {
    width: 100%;
    text-align: center;
  }

  #shopify-section-announcement
  .announcement__text p {
    margin: 0;

    font-size: 13px;
    line-height: 18px;
    font-weight: 400;

    color: #13322b;
  }

  #shopify-section-announcement
  .announcement__text a {
    color: #13322b;
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-left: 2px;
  }

  #shopify-section-announcement
  .announcement__text strong {
    font-weight: 600;
  }


  /*
   * Remove any Flickity arrows
   * if the theme generates them.
   */
  #shopify-section-announcement
  .flickity-prev-next-button,
  #shopify-section-announcement
  .flickity-button {
    display: none !important;
  }


  @media screen and (max-width: 767px) {

    #shopify-section-announcement
    .announcement__bar-holder {
      height: 48px;
    }

    #shopify-section-announcement
    .announcement__bar {
      padding: 5px 15px;
    }

    #shopify-section-announcement
    .announcement__text p {
      font-size: 12px;
      line-height: 16px;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    #shopify-section-announcement
    .announcement__bar {
      transition: none;
    }

  }
</style>


<script>
(function () {

  var slider = document.querySelector(
    '#shopify-section-announcement [data-announcement-slider]'
  );

  if (!slider) return;


  var slides = slider.querySelectorAll(
    '[data-slide]'
  );

  if (!slides.length) return;


  var current = 0;

  var speed = parseInt(
    slider.getAttribute('data-slider-speed'),
    10
  ) || 8000;

  var timer = null;


  /*
   * Show slide
   */
  function showSlide(index) {

    if (index >= slides.length) {
      index = 0;
    }

    if (index < 0) {
      index = slides.length - 1;
    }


    slides.forEach(function (slide) {

      slide.classList.remove(
        'is-selected'
      );

    });


    slides[index].classList.add(
      'is-selected'
    );


    current = index;
  }


  /*
   * Next announcement
   */
  function nextSlide() {

    showSlide(
      current + 1
    );

  }


  /*
   * Stop autoplay
   */
  function stopSlider() {

    if (timer) {

      clearInterval(timer);

      timer = null;

    }

  }


  /*
   * Start autoplay
   */
  function startSlider() {

    stopSlider();

    if (slides.length <= 1) {
      return;
    }


    timer = setInterval(
      function () {

        nextSlide();

      },
      speed
    );

  }


  /*
   * Click announcement bar
   * = next announcement
   *
   * Clicking Shop Now still opens link.
   */
  slider.addEventListener(
    'click',
    function (event) {

      if (
        event.target.closest('a')
      ) {
        return;
      }


      nextSlide();

      startSlider();

    }
  );


  /*
   * Pause on hover
   */
  slider.addEventListener(
    'mouseenter',
    function () {

      stopSlider();

    }
  );


  /*
   * Restart on mouse leave
   */
  slider.addEventListener(
    'mouseleave',
    function () {

      startSlider();

    }
  );


  /*
   * Pause when browser tab hidden
   */
  document.addEventListener(
    'visibilitychange',
    function () {

      if (document.hidden) {

        stopSlider();

      } else {

        startSlider();

      }

    }
  );


  showSlide(0);

  startSlider();

})();
</script>