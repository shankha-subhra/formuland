<style>
  #announcement-slider-{{ section.id }} {
    position: relative;
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    z-index: 999;
  }

  #announcement-slider-{{ section.id }} .fas-track {
    position: relative;
    min-height: {{ section.settings.height }}px;
  }

  #announcement-slider-{{ section.id }} .fas-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;

    padding: 8px 45px;

    opacity: 0;
    visibility: hidden;

    transform: translateY(8px);

    transition:
      opacity .35s ease,
      transform .35s ease,
      visibility .35s ease;
  }

  #announcement-slider-{{ section.id }} .fas-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    position: relative;
  }

  #announcement-slider-{{ section.id }} .fas-message {
    margin: 0;

    font-size: {{ section.settings.font_size }}px;
    line-height: 1.4;
    font-weight: {{ section.settings.font_weight }};

    color: inherit;
  }

  #announcement-slider-{{ section.id }} .fas-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;

    margin-left: 5px;

    font-weight: 600;
  }

  #announcement-slider-{{ section.id }} .fas-link:hover {
    opacity: .75;
  }

  #announcement-slider-{{ section.id }} .fas-arrow {
    position: absolute;
    top: 50%;

    transform: translateY(-50%);

    width: 32px;
    height: 32px;

    border: 0;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background: transparent;
    color: inherit;

    cursor: pointer;

    z-index: 5;
  }

  #announcement-slider-{{ section.id }} .fas-prev {
    left: 10px;
  }

  #announcement-slider-{{ section.id }} .fas-next {
    right: 10px;
  }

  #announcement-slider-{{ section.id }} .fas-arrow svg {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 767px) {

    #announcement-slider-{{ section.id }} .fas-track {
      min-height: {{ section.settings.mobile_height }}px;
    }

    #announcement-slider-{{ section.id }} .fas-slide {
      padding: 7px 38px;
    }

    #announcement-slider-{{ section.id }} .fas-message {
      font-size: {{ section.settings.mobile_font_size }}px;
    }

    #announcement-slider-{{ section.id }} .fas-arrow {
      width: 28px;
      height: 28px;
    }

  }

  @media (prefers-reduced-motion: reduce) {

    #announcement-slider-{{ section.id }} .fas-slide {
      transition: none;
    }

  }
</style>


<div
  id="announcement-slider-{{ section.id }}"
  class="formuland-announcement-slider"
  data-announcement-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>

  <div class="fas-track">

    {% for block in section.blocks %}

      <div
        class="fas-slide {% if forloop.first %}is-active{% endif %}"
        data-announcement-slide
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >

        <p class="fas-message">

          {% if block.settings.icon != blank %}
            <span class="fas-icon">
              {{ block.settings.icon }}
            </span>
          {% endif %}

          {{ block.settings.text }}

          {% if block.settings.link_text != blank %}

            <a
              class="fas-link"
              href="{{ block.settings.link }}"
            >
              {{ block.settings.link_text }}
            </a>

          {% endif %}

        </p>

      </div>

    {% endfor %}

  </div>


  {% if section.blocks.size > 1 %}

    {% if section.settings.show_arrows %}

      <button
        type="button"
        class="fas-arrow fas-prev"
        data-announcement-prev
      >
        <svg
          viewBox="0 0 10 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M8 2L2 8L8 14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>


      <button
        type="button"
        class="fas-arrow fas-next"
        data-announcement-next
      >
        <svg
          viewBox="0 0 10 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M2 2L8 8L2 14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>

    {% endif %}

  {% endif %}

</div>


<script>
(function () {

  var slider = document.getElementById(
    'announcement-slider-{{ section.id }}'
  );

  if (!slider) return;

  var slides = slider.querySelectorAll(
    '[data-announcement-slide]'
  );

  if (!slides.length) return;


  var prev = slider.querySelector(
    '[data-announcement-prev]'
  );

  var next = slider.querySelector(
    '[data-announcement-next]'
  );


  var current = 0;

  var autoplay =
    slider.getAttribute('data-autoplay') === 'true';

  var speed =
    parseInt(
      slider.getAttribute('data-speed'),
      10
    ) || 4000;

  var timer = null;


  function showSlide(index) {

    if (index >= slides.length) {
      index = 0;
    }

    if (index < 0) {
      index = slides.length - 1;
    }

    slides.forEach(function (slide) {
      slide.classList.remove('is-active');
    });

    slides[index].classList.add('is-active');

    current = index;
  }


  function nextSlide() {
    showSlide(current + 1);
  }


  function prevSlide() {
    showSlide(current - 1);
  }


  function stopAutoplay() {

    if (timer) {
      clearInterval(timer);
      timer = null;
    }

  }


  function startAutoplay() {

    stopAutoplay();

    if (
      !autoplay ||
      slides.length <= 1
    ) {
      return;
    }

    timer = setInterval(
      nextSlide,
      speed
    );
  }


  if (next) {

    next.addEventListener(
      'click',
      function () {

        nextSlide();
        startAutoplay();

      }
    );

  }


  if (prev) {

    prev.addEventListener(
      'click',
      function () {

        prevSlide();
        startAutoplay();

      }
    );

  }


  slider.addEventListener(
    'mouseenter',
    stopAutoplay
  );


  slider.addEventListener(
    'mouseleave',
    startAutoplay
  );


  document.addEventListener(
    'visibilitychange',
    function () {

      if (document.hidden) {
        stopAutoplay();
      } else {
        startAutoplay();
      }

    }
  );


  showSlide(0);
  startAutoplay();

})();
</script>


{% schema %}
{
  "name": "Announcement Slider",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#13322B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 30,
      "max": 80,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 30,
      "max": 100,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slide every",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "s"
    }
  ],

  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / emoji"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Announcement",
          "default": "Fast and Free Shipping on 4/6/8/12 Packs."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Announcement Slider",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "⚡",
            "text": "Fast and Free Shipping on 4/6/8/12 Packs.",
            "link_text": "Shop Now"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "🏆",
            "text": "Shop our Best Selling European Baby Formulas.",
            "link_text": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}