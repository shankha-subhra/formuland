    gap: 18px;
  }

  .fhd__utility { display: flex; align-items: center; gap: 26px; }
  .fhd__utility-link {
    font-family: 'Libre Franklin', 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
    letter-spacing: .02em;
    color: currentColor;
    text-decoration: none;
    white-space: nowrap;
    opacity: .92;
    transition: opacity .2s ease;
  }
  .fhd__utility-link:hover { opacity: 1; text-decoration: underline; text-underline-offset: 3px; }

  .fhd__logo .header__logo__link { display: block; margin: 0 auto; }

  /* logo swap: color logo by default */
  .fhd .logo__img--transparent { display: none; }

  /* ---------- Search (original theme capsule — theme CSS styles it;
     only alignment + transparent-state colors are handled here) ---------- */
  .fhd__top-right .capsule-form { margin: 0; }
  .fhd__top-right .searchBarStyle { display: flex; align-items: center; }
  .fhd--transparent .fhd__header:not(:hover):not(:focus-within) .searchBarStyle {
    border-color: currentColor;
    background: transparent;
  }
  .fhd--transparent .fhd__header:not(:hover):not(:focus-within) .capsule-input {
    color: currentColor;
    background: transparent;
  }
  .fhd--transparent .fhd__header:not(:hover):not(:focus-within) .capsule-input::placeholder {
    color: currentColor;
    opacity: .75;
  }
  .fhd--transparent .fhd__header:not(:hover):not(:focus-within) .icon-search-place { fill: currentColor; }
  .fhd--transparent.fhd--scrolled .fhd__header .capsule-input,
  .fhd--transparent.fhd--mega-open .fhd__header .capsule-input { color: var(--fhd-ink); }

  .fhd__icon-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: currentColor;
  }
  .fhd__icon-link svg { display: block; width: 20px; height: 20px; }
  .fhd__icon-link .header__cart__status {
    font-size: 11px;
    margin-left: 4px;
  }
  .fhd__icon-link .header__cart__status [data-header-cart-price],
  .fhd__icon-link .header__cart__status [data-hulkapps-cart-total] { display: none; }

  /* ---------- Main nav row ---------- */
  .fhd__nav-row {
    border-top: 1px solid transparent;
    transition: border-color .28s ease;
  }
  .fhd__nav-list {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fhd__nav-item { position: relative; }
  .fhd__nav-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 18px;
    font-family: 'Libre Franklin', 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    letter-spacing: 0;
    text-transform: none;
    color: currentColor;
    text-decoration: none;
    white-space: nowrap;
    position: relative;
  }
  .fhd__nav-link::after {
    content: '';
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .25s ease;
  }
  .fhd__nav-item:hover > .fhd__nav-link::after,
  .fhd__nav-item--active > .fhd__nav-link::after,
  .fhd__nav-item:focus-within > .fhd__nav-link::after { transform: scaleX(1); }

  .fhd__caret { transition: transform .25s ease; }
  .fhd__nav-item--mega:hover .fhd__caret,
  .fhd__nav-item--mega:focus-within .fhd__caret { transform: rotate(180deg); }

  /* ---------- Mega menu (full-bleed width) ---------- */
  .fhd__mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    transform: translateY(8px);
    background: var(--fhd-mega-bg);
    color: var(--fhd-ink);
    border-top: 1px solid rgba(19, 50, 43, .08);
    border-bottom: 1px solid rgba(19, 50, 43, .12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .22s ease .08s, transform .22s ease .08s, visibility 0s linear .3s;
    z-index: 70;
  }
  /* Invisible hover bridge: fills the gap between the nav link and the
     panel so the pointer never "exits" the nav item while travelling down —
     fixes the dropdown collapsing mid-travel (Rudolph, 8/8) */
  .fhd__mega::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 24px;
  }
  .fhd__nav-item--mega:hover > .fhd__mega,
  .fhd__nav-item--mega:focus-within > .fhd__mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }

  /* Static mega-menu positioning: anchor to the header row, not the item, so
     the panel spans the full header width regardless of item position */
  .fhd__nav-item--mega { position: static; }
  .fhd__nav-row { position: relative; }

  .fhd__mega-inner {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 48px;
    padding: 40px 48px 44px;
    text-align: left;
    max-width: 1360px;
    margin: 0 auto;
  }

  .fhd__mega-promo { border-right: 1px solid rgba(19, 50, 43, .12); padding-right: 40px; }
  .fhd__stars { color: #13322B; letter-spacing: 2px; margin-right: 8px; }
  .fhd__mega-eyebrow {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .fhd__mega-heading {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 24px;
    line-height: 1.3;
    margin: 0 0 14px;
  }
  .fhd__mega-text {
    font-family: 'Libre Franklin', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 20px;
    opacity: .85;
  }
  .fhd__btn {
    display: block;
    text-align: center;
    font-family: 'Tenor Sans', sans-serif;
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 12px 18px;
    margin-bottom: 12px;
    text-decoration: none;
    transition: background-color .2s ease, color .2s ease;
  }
  .fhd__btn--outline {
    border: 1px solid var(--fhd-ink);
    color: var(--fhd-ink);
    background: transparent;
  }
  .fhd__btn--outline:hover { background: var(--fhd-ink); color: #fff; }
  .fhd__btn--solid {
    background: var(--fhd-ink);
    color: #fff;
    border: 1px solid var(--fhd-ink);
  }
  .fhd__btn--solid:hover { background: #0c241f; color: #fff; }
  .fhd__mega-note {
    font-family: 'Libre Franklin', sans-serif;
    font-size: 11px;
    opacity: .7;
    margin: 6px 0 0;
  }

  .fhd__mega-cols {
    columns: 4;
    column-gap: 40px;
  }
  .fhd__mega-group {
    break-inside: avoid;
    margin-bottom: 22px;
  }
  .fhd__mega-group-title {
    display: block;
    font-family: 'Tenor Sans', sans-serif;
    font-size: 12.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--fhd-ink);
    text-decoration: none;
    margin-bottom: 10px;
  }
  .fhd__mega-group-title:hover { text-decoration: underline; text-underline-offset: 3px; }
  .fhd__mega-sublist { list-style: none; margin: 0; padding: 0; }
  .fhd__mega-sublink {
    display: block;
    font-family: 'Libre Franklin', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    padding: 3px 0;
    color: var(--fhd-ink);
    text-decoration: none;
    opacity: .82;
    transition: opacity .15s ease;
  }
  .fhd__mega-sublink:hover { opacity: 1; text-decoration: underline; text-underline-offset: 3px; }

  /* =========================================================
     TRANSPARENT STATE — homepage only
     ========================================================= */

  /* Take the header out of the flow so it overlays the hero video.
     It stays directly below the announcement bar in the DOM, so with
     height:0 + overflow visible it paints on top of the next section. */
  .fhd--transparent {
    height: 0;
    overflow: visible;
    position: relative;
    z-index: 100;
  }

  .fhd--transparent .fhd__header {
  }
  .fhd--transparent .fhd__header .logo__img--color { display: none; }
  .fhd--transparent .fhd__header .logo__img--transparent { display: block; }
  .fhd--transparent .fhd__header .header__logo__text { color: var(--COLOR-NAV-TEXT-TRANSPARENT); }

  /* No white logo uploaded? Auto-invert the color logo while transparent.
     Reversion to the color logo is handled in the solid-trigger blocks below. */
  .fhd--transparent .fhd__header .header__logo:not(.header__logo--has-transparent) .logo__img--color {
    display: block;
  }

  

  {% unless request.page_type == 'index' %}
  .fhd--transparent {    
    height: 0;
  }
  .fhd--transparent .fhd__header .header__logo:not(.header__logo--has-transparent) .logo__img--color {    
    filter: brightness(0) invert(1);
  }
{% endunless %}

  /* SOLID triggers, all viewports: scrolled or mega open.
     Fully opaque white — no blur, no shadow, no translucency. */
  .fhd--transparent.fhd--scrolled .fhd__header,
  .fhd--transparent.fhd--mega-open .fhd__header {
    background: var(--fhd-bg);
    color: var(--fhd-ink);
    border-bottom: 1px solid rgba(19, 50, 43, .08);
  }
  .fhd--transparent.fhd--scrolled .fhd__header .logo__img--color,
  .fhd--transparent.fhd--mega-open .fhd__header .logo__img--color { display: block; }
  .fhd--transparent.fhd--scrolled .fhd__header .logo__img--transparent,
  .fhd--transparent.fhd--mega-open .fhd__header .logo__img--transparent { display: none; }
  .fhd--transparent.fhd--scrolled .fhd__header .header__logo:not(.header__logo--has-transparent) .logo__img--color,
  .fhd--transparent.fhd--mega-open .fhd__header .header__logo:not(.header__logo--has-transparent) .logo__img--color {
    filter: none;
  }

  /* SOLID triggers, desktop only: hover or keyboard focus.
     Scoped to desktop so mobile focus (e.g. after the drawer closes and
     returns focus to the burger) can't turn the bar white under white icons. */
  @media only screen and (min-width: 1024px) {
    .fhd--transparent .fhd__header:hover,
    .fhd--transparent .fhd__header:focus-within {
      background: var(--fhd-bg);
      color: var(--fhd-ink);
      border-bottom: 1px solid rgba(19, 50, 43, .08);
    }
    .fhd--transparent .fhd__header:hover .logo__img--color,
    .fhd--transparent .fhd__header:focus-within .logo__img--color { display: block; }
    .fhd--transparent .fhd__header:hover .logo__img--transparent,
    .fhd--transparent .fhd__header:focus-within .logo__img--transparent { display: none; }
    .fhd--transparent .fhd__header:hover .header__logo:not(.header__logo--has-transparent) .logo__img--color,
    .fhd--transparent .fhd__header:focus-within .header__logo:not(.header__logo--has-transparent) .logo__img--color {
      filter: none;
    }
  }

  /* Sticky when scrolled (transparent pages) so the solid header follows */
  .fhd--transparent.fhd--scrolled .fhd__header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    animation: fhdSlideDown .3s ease;
  }
  @keyframes fhdSlideDown {
    from { transform: translateY(-100%); }
    to   { transform: translateY(0); }
  }

  /* Solid pages: hairline dividers only */
  .fhd:not(.fhd--transparent) .fhd__nav-row { border-top-color: rgba(19, 50, 43, .08); }
  .fhd:not(.fhd--transparent) .fhd__header { border-bottom: 1px solid rgba(19, 50, 43, .08); }

  /* =========================================================
     HOMEPAGE HERO CLEARANCE
     The transparent header overlays the top of the hero video, so the
     hero's end-of-video text must start below it. --fhd-header-height is
     set by this section's JS from the real rendered header height
     (desktop two-tier or mobile bar), so the clearance is always exact.
     ========================================================= */
  .fhv2__overlay {
    padding-top: calc(var(--fhd-header-height, 150px) + 20px) !important;
  }
  @media only screen and (max-width: 768px) {
    .fhv2__overlay {
      padding-top: calc(var(--fhd-header-height, 70px) + 16px) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fhd__header, .fhd__mega, .fhd__caret, .fhd__nav-link::after { transition: none !important; animation: none !important; }
  }

  /* =========================================================
