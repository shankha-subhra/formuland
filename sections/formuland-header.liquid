    transition: background-color .28s ease, color .28s ease;
    position: relative;
    z-index: 60;
  }

  /* Full-width top row, 100px side padding (design update 8/4) */
  .fhd__top-wrap {
    width: 100%;
    padding: 0 100px;
    box-sizing: border-box;
  }

  /* ---------- Top utility row ---------- */
  .fhd__top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 10px 0 8px;
  }
  .fhd__top-left { justify-self: start; }
  .fhd__top-center { justify-self: center; }
  .fhd__top-right {
