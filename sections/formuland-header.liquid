  .fhd__mbar-btn .header__cart__status { font-size: 11px; margin-left: 3px; }
  .fhd__mbar-btn .header__cart__status [data-header-cart-price],
  .fhd__mbar-btn .header__cart__status [data-hulkapps-cart-total] { display: none; }

  /* ---------- Drawer shell ---------- */
  .fhd__mdrawer {
    position: fixed;
    inset: 0;
    z-index: 100000; /* above the announcement bar so the close button is never covered */
    background: var(--fhd-mega-bg);
    color: var(--fhd-ink);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    visibility: hidden;
    transition: transform .32s ease, visibility 0s linear .32s;
  }
  .fhd__mdrawer.is-open {
    transform: translateX(0);
    visibility: visible;
    transition-delay: 0s;
  }
  body.fhd-drawer-open { overflow: hidden; }
  /* The announcement bar uses its own very high z-index, so instead of
     fighting it, hide its whole section while the menu drawer is open.
     Targets the Shopify section wrapper of the announcement section. */
  body.fhd-drawer-open [id^="shopify-section"][id*="announcement"],
  body.fhd-drawer-open [id^="shopify-section"][id*="Announcement"],
  body.fhd-drawer-open .announcement__wrapper,
  body.fhd-drawer-open [data-section-type="announcement"] {
    visibility: hidden !important;
  }

  .fhd__mdrawer-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 14px 18px;
    background: var(--fhd-bg);
    border-bottom: 1px solid rgba(19, 50, 43, .08);
    flex: 0 0 auto;
  }
  .fhd__mdrawer-logo { justify-self: center; }
  .fhd__mdrawer-logo img { display: block; max-width: 150px; height: auto; }

  .fhd__mdrawer-search {
    margin: 16px 18px 8px;
    flex: 0 0 auto;
  }

  /* ---------- Slide panes ---------- */
  .fhd__panes {
    position: relative;
    flex: 1 1 auto;
    overflow: hidden;
  }
  .fhd__pane {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 6px 18px 28px;
    background: var(--fhd-mega-bg);
    transform: translateX(100%);
    transition: transform .3s ease;
    display: flex;
    flex-direction: column;
  }
  .fhd__pane--active { transform: translateX(0); }
  .fhd__pane--left { transform: translateX(-30%); }

  .fhd__mlist { list-style: none; margin: 0; padding: 0; }
  .fhd__mitem { border-bottom: 1px solid rgba(19, 50, 43, .1); }
  .fhd__mlink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 12px;
    padding: 16px 6px;
    font-family: 'Libre Franklin', 'Helvetica Neue', Arial, sans-serif;
    font-size: 15px;
    color: var(--fhd-ink);
    text-decoration: none;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
    transition: background-color .15s ease;
  }
  .fhd__mlink:hover,
  .fhd__mlink--parent:active { background: rgba(19, 50, 43, .05); }
  .fhd__arrow { flex: 0 0 auto; opacity: .8; }

  .fhd__mback {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 16px 6px;
    margin-bottom: 4px;
    font-family: 'Libre Franklin', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--fhd-ink);
    background: none;
    border: 0;
    border-bottom: 1px solid rgba(19, 50, 43, .18);
    text-align: left;
    cursor: pointer;
  }

  /* ---------- Bottom promo (root pane) ---------- */
  .fhd__mpromo {
    margin-top: auto;
    padding-top: 26px;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 22px;
    align-items: start;
  }
  .fhd__mpromo-copy { border-right: 1px solid rgba(19, 50, 43, .14); padding-right: 22px; }
  .fhd__mpromo .fhd__mega-heading { font-size: 19px; }
  .fhd__mpromo .fhd__mega-text { margin-bottom: 0; }
  .fhd__mpromo-actions .fhd__btn { margin-bottom: 10px; }
  @media only screen and (max-width: 599px) {
    .fhd__mpromo { grid-template-columns: 1fr; }
    .fhd__mpromo-copy { border-right: 0; padding-right: 0; }
  }

  /* ---------- Visibility split + transparent homepage bar ---------- */
  @media only screen and (max-width: 1023px) {
    .fhd__desktop { display: none; }
    .header__mobile { display: block; }
    .fhd--transparent .header__mobile { color: var(--COLOR-NAV-TEXT-TRANSPARENT); }
    .fhd--transparent.fhd--scrolled .header__mobile { color: var(--fhd-ink); }
  }
  @media only screen and (min-width: 1024px) {
    .header__mobile { display: none; }
    .fhd__mdrawer { display: none; }
  }
</style>

<script>
  (function () {
    var wrapper = document.querySelector('[data-fhd]');
    if (!wrapper) return;

    var header = wrapper.querySelector('.fhd__header');
    var isTransparent = wrapper.classList.contains('fhd--transparent');

    /* Publish the real rendered header height (desktop rows or mobile bar)
       so the homepage hero can pad its text overlay below the header. */
    function setHeightVar() {
      document.documentElement.style.setProperty('--fhd-header-height', header.offsetHeight + 'px');
    }
    window.addEventListener('load', setHeightVar);
    window.addEventListener('resize', setHeightVar);
    setHeightVar();

    /* Transparent homepage: solid + fixed once the user scrolls past the hero top */
    if (isTransparent) {
      var THRESHOLD = 80;
      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          wrapper.classList.toggle('fhd--scrolled', window.scrollY > THRESHOLD);
          ticking = false;
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    /* aria-expanded bookkeeping + mega-open class (keeps header solid while
       the panel is hovered even if the pointer leaves the bar itself) */
    var megaItems = wrapper.querySelectorAll('.fhd__nav-item--mega');
    megaItems.forEach(function (item) {
      var trigger = item.querySelector('.fhd__nav-link');
      function open()  {
        trigger.setAttribute('aria-expanded', 'true');
        wrapper.classList.add('fhd--mega-open');
      }
      function close() {
        trigger.setAttribute('aria-expanded', 'false');
        wrapper.classList.remove('fhd--mega-open');
      }
      item.addEventListener('mouseenter', open);
      item.addEventListener('mouseleave', close);
      item.addEventListener('focusin', open);
      item.addEventListener('focusout', function (e) {
        if (!item.contains(e.relatedTarget)) close();
      });
      /* Escape closes the panel and returns focus to the trigger */
      item.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { close(); trigger.focus(); }
      });
    });

    /* =====================================================
       Mobile / tablet drawer — open/close + 3-level panes
       ===================================================== */
    var mdrawer = wrapper.querySelector('[data-fhd-drawer]');
    var burger = wrapper.querySelector('[data-fhd-drawer-open]');
    if (mdrawer && burger) {
      var panes = mdrawer.querySelectorAll('[data-fhd-pane]');
      var activeId = 'root';

      function getPane(id) {
        return mdrawer.querySelector('[data-fhd-pane="' + id + '"]');
      }

      function showPane(id, direction) {
        var next = getPane(id);
        var current = getPane(activeId);
        if (!next || next === current) return;
        panes.forEach(function (p) {
          p.classList.remove('fhd__pane--active', 'fhd__pane--left');
        });
        if (direction === 'forward' && current) current.classList.add('fhd__pane--left');
        next.classList.add('fhd__pane--active');
        next.scrollTop = 0;
        activeId = id;
      }

      function getAnnouncementEls() {
        return document.querySelectorAll(
          '[id^="shopify-section"][id*="announcement" i], .announcement__wrapper, [data-section-type="announcement"]'
        );
      }

      function openDrawer() {
        mdrawer.classList.add('is-open');
        mdrawer.setAttribute('aria-hidden', 'false');
        burger.setAttribute('aria-expanded', 'true');
        document.body.classList.add('fhd-drawer-open');
        getAnnouncementEls().forEach(function (el) { el.style.visibility = 'hidden'; });
        showPane('root', 'back');
      }
      function closeDrawer() {
        mdrawer.classList.remove('is-open');
        mdrawer.setAttribute('aria-hidden', 'true');
        burger.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('fhd-drawer-open');
        getAnnouncementEls().forEach(function (el) { el.style.visibility = ''; });
        burger.focus();
      }

      burger.addEventListener('click', openDrawer);
      mdrawer.querySelectorAll('[data-fhd-drawer-close]').forEach(function (btn) {
        btn.addEventListener('click', closeDrawer);
      });

      /* Opening the cart from inside the menu drawer: close the menu first
         so the cart drawer isn't stacked underneath it */
      mdrawer.querySelectorAll('[data-drawer-toggle="drawer-cart"]').forEach(function (btn) {
        btn.addEventListener('click', function () { closeDrawer(); });
      });

      /* drill down */
      mdrawer.querySelectorAll('[data-fhd-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          showPane(btn.getAttribute('data-fhd-open'), 'forward');
        });
      });

      /* back */
      mdrawer.querySelectorAll('[data-fhd-back]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var pane = btn.closest('[data-fhd-pane]');
          var parent = pane ? pane.getAttribute('data-fhd-parent') : 'root';
          showPane(parent || 'root', 'back');
        });
      });

      /* Escape closes the drawer */
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && mdrawer.classList.contains('is-open')) closeDrawer();
      });

      /* Close on breakpoint change so state can't get stuck */
      var mq = window.matchMedia('(min-width: 1024px)');
      (mq.addEventListener ? mq.addEventListener.bind(mq, 'change') : mq.addListener.bind(mq))(function (e) {
        if (e.matches && mdrawer.classList.contains('is-open')) closeDrawer();
      });
    }
  })();
</script>


</div>
