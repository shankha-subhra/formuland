<section class="shopify-section fcc-cta-section" id="shopify-section-{{ section.id }}">
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&amp;family=Libre+Franklin:wght@400;500;600&amp;family=Tenor+Sans&amp;display=swap" rel="stylesheet"/>
<style data-shopify="">
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd {
    position: relative;
    padding: 140px 24px 140px;
    background-color: #0b1d19;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 600px;
  }

  /* Background image & overlay */
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    display: block;
  }#fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(11, 29, 25, 0.55) 0%,
      rgba(11, 29, 25, 0.33) 45%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  /* Content */
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__wrap {
    position: relative;
    z-index: 2;
    max-width: 1360px;
    width: 100%;
    margin: 0 auto;
  }
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__content {
    max-width: 620px;
  }

  /* Typography */
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__heading {
    font-family: 'Libre Baskerville', serif !important;
    font-weight: 400 !important;
    font-size: 42px !important;
    line-height: 1.25 !important;
    color: #efefe3;
    margin: 0 0 24px;
  }
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__heading em {
    font-style: italic !important;
    color: #e6f28c !important;
  }

  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__text {
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 16px !important;
    line-height: 1.65 !important;
    color: #efefe3;
    opacity: 0.95;
    margin: 0 0 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__text p {
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }
  /* Bold in the editor maps to the accent color, not physical bold */
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__text strong {
    font-weight: 400 !important;
    color: #e6f28c !important;
  }
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__text a {
    color: #e6f28c !important;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Button */
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__btn {
    display: inline-block;
    padding: 16px 36px;
    border: 1px solid #efefe3;
    color: #efefe3;
    text-decoration: none;
    font-family: 'Libre Franklin', sans-serif !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color 0.3s ease, color 0.3s ease;
    background: transparent;
  }
  #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__btn:hover {
    background-color: #efefe3;
    color: #0b1d19;
  }

  /* Tablet & mobile */
  @media (max-width: 1024px) {
    #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd {
      align-items: flex-start;
      min-height: 500px;
      padding-top: 64px;
      padding-bottom: 64px;
    }
    #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__bg img {
      object-position: center bottom;
    }
    #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__overlay {
      background: linear-gradient(
        to bottom,
        rgba(11, 29, 25, 0.55) 0%,
        rgba(11, 29, 25, 0.33) 50%,
        rgba(0, 0, 0, 0) 100%
      );
    }
    #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__heading { font-size: 34px !important; }
    #fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd .fcc-cta__text {
      font-size: 15px !important;
      gap: 20px;
      margin-bottom: 32px;
    }
  }
</style>
<section aria-labelledby="fcc-cta-heading-template--22974334501083__fcc_purchase_cta_WVHeMd" class="fcc-cta" id="fcc-cta-template--22974334501083__fcc_purchase_cta_WVHeMd">
<div aria-hidden="true" class="fcc-cta__bg"><img alt="" height="906" loading="lazy" src="//formuland.com/cdn/shop/files/Section_Container_11.png?v=1787251843&amp;width=2400" srcset="//formuland.com/cdn/shop/files/Section_Container_11.png?v=1787251843&amp;width=800 800w, //formuland.com/cdn/shop/files/Section_Container_11.png?v=1787251843&amp;width=1200 1200w, //formuland.com/cdn/shop/files/Section_Container_11.png?v=1787251843&amp;width=1920 1920w, //formuland.com/cdn/shop/files/Section_Container_11.png?v=1787251843&amp;width=2400 2400w" style="object-position:68.848% 50.0%;" width="2400"/>
<div class="fcc-cta__overlay"></div>
</div>
<div class="fcc-cta__wrap">
<div class="fcc-cta__content">
<h2 class="fcc-cta__heading" id="fcc-cta-heading-template--22974334501083__fcc_purchase_cta_WVHeMd">{{ section.settings.heading_purchase }}</h2>
<div class="fcc-cta__text">
<p>HiPP Organic formula has earned the trust of parents across Europe and increasingly across the United States. At Formuland, we make it straightforward to find the right stage and specialty, order with confidence, and receive your formula quickly.</p><p>Buy <strong>HiPP formula</strong> and more from <strong>Formuland</strong> today to experience the difference.</p>
</div><a class="fcc-cta__btn" href="#curated-range" id="fcc-cta-btn-template--22974334501083__fcc_purchase_cta_WVHeMd">
          BUY HIPP FORMULA NOW
        </a></div>
</div>
</section>
<script>
  (function () {
    var cta = document.getElementById('fcc-cta-btn-template--22974334501083__fcc_purchase_cta_WVHeMd');
    if (!cta) return;
    cta.addEventListener('click', function (e) {
      var href = cta.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;
      e.preventDefault();
      var target = href.length > 1 ? document.getElementById(href.slice(1)) : null;
      if (target) {
        var top = target.getBoundingClientRect().top + window.pageYOffset - 100;
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  })();
</script>
</section>
{% schema %}
{
  "name": "Collection Purchase CTA",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading_purchase",
      "label": "Heading: Purchase Today",
      "default": "Purchase <em>HiPP Organic Baby Formula </em>Today"
    }
  ],
  "presets": [
    {
      "name": "Formula Collection Purchase CTA"
    }
  ]
}
{% endschema %}
